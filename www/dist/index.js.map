<Component id="Badge">

  <Signature purpose="Small label for status, counts, or categorization"
    description="Compact visual indicator for metadata like status tags, notification counts, or category labels. Use for item counts, status indicators, or category chips in lists and cards."
    group="Typography">
    <Prop id="text" type="string" description="Badge label text" />
    <Prop id="type" type="enum"
      enum="primary,secondary,accent,info,success,warning,error,outline,dash"
      description="Semantic color type" />
    <Prop id="mode" type="enum" enum="soft,outline,dash,ghost,neutral"
      description="Visual style variant" />
    <Prop id="size" type="enum" enum="xs,sm,md,lg,xl" description="Badge size" />
    <Slot name="default" description="Custom badge content (alternative to text prop)" />
  </Signature>

  <div class="badge {arrayJoin(arrayPrefixAll('badge-', mode, type, size),' ')} {class}">
    <span If="text" class="truncate">{text}</span>
    <Slot />
  </div>
</Component>