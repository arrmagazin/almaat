<Component id="TableColumnsSelector">
  <Signature purpose="ColumnsSelector"
    description="Dropdown that toggles which table columns are visible. The first column is always shown; the choice persists per namespace in localStorage."
    group="Table">
    <Prop id="namespace" type="string" description="persistence key, e.g. words/verbs/catalog" />
    <Prop id="columns" type="array"
      description="column definitions; defaults to R.forms['table_'+namespace]" />
  </Signature>

  <!-- toggleable columns = every column except the first (always-on row header) -->
  <Connector Ref="cols def" data="{slice(columns ?? R.forms['table_'+namespace], 1)}"
    change="-> cols" />
  <!-- comma-separated ids hidden for this namespace -->
  <Connector Ref="hidden" data="{dot(@localStorage.hiddenColumns, namespace)}" change="-> hidden" />

  <div class="{class}">
    <button aria-selected="{opened}"
      class="btn btn-circle {opened ? 'btn-primary' : 'btn-ghost'} {class}"
      click="-> opened = !opened"
      title="Choose columns">
      <div class="h-5 w-5 icon icon-columns-3" />
    </button>

    <div class="{opened ? 'relative' : ''}">
      <DropdownOptionsList
        caption="Columns"
        class="right-0 absolute"
        options="{cols}"
        values="{map(filterBySelection(cols, 'unselected', hidden), R.functions.dot, 'id')}"
        multiItemClick="-> @localStorage.hiddenColumns = assign(objectCreate(), @localStorage.hiddenColumns, pack(
            includes(split(hidden, ','), event.value)
              ? arrayJoin(map(filterNot(narrowItemList(hidden), 'id', event.value), R.functions.dot, 'id'))
              : stringMerge(hidden, event.value),
            namespace))"
        close="-> opened=false"
        If="opened" />
    </div>
  </div>
</Component>