<Component id="ModalShowButton">
  <Signature purpose="Trigger button that opens a modal with slotted content"
    description="Self-contained button + Modal that manages its own open/close state. Pass the modal body as default slot content; pass action buttons via Slot='footer'. Modal already provides an X / backdrop close, so footer buttons need not close it."
    group="Layout">
    <!-- trigger button (prop-driven: rendered here so its click can set the internal `opened`) -->
    <Prop id="icon" type="string" description="Lucide icon for the trigger" />
    <Prop id="text" alias="title" type="string" description="Trigger label" />
    <Prop id="type" type="enum"
      enum="neutral,ghost,primary,secondary,accent,error,warning,success"
      default="ghost" description="Trigger visual type" />
    <Prop id="mode" type="enum" enum="dash,inverted,outline,soft" description="Trigger visual mode" />
    <Prop id="size" type="enum" enum="lg,md,sm,xl,xs" description="Trigger size" />
    <Prop id="alt" type="string" description="Trigger tooltip" />
    <Prop id="busy" type="boolean" description="Spinner on the trigger" />
    <Prop id="disabled" type="boolean" description="Disable the trigger" />
    <Prop id="class" type="class" description="Extra trigger classes (e.g. 'btn-circle')" />
    <!-- modal -->
    <Prop id="modalTitle" type="string" description="Modal header title" />
    <Prop id="modalClass" type="class" description="Extra modal dialog classes (e.g. 'w-2xl')" />
    <Slot name="default" description="Modal body content" />
    <Slot name="header" description="Custom modal header (replaces modalTitle)" />
    <Slot name="footer" description="Modal footer action buttons" />
  </Signature>

  <Btn icon="{icon}" text="{text}" type="{type ?? 'ghost'}" mode="{mode}" size="{size}"
    alt="{alt}" busy="{busy}" disabled="{disabled}" class="{class}"
    click="-> opened = true" />

  <Modal hidden="{!opened}" class="{modalClass}" title="{modalTitle??text}"
    close="-> opened = false">
    <Fragment Slot="header">
      <Fragment If="Slot(header)">
        <Slot Key="header" If="opened" />
      </Fragment>
    </Fragment>
    <Fragment If="opened">
      <Slot />
    </Fragment>
    <Fragment Slot="footer">
      <Fragment If="Slot(footer)">
        <Slot Key="footer" If="opened" />
      </Fragment>
    </Fragment>
  </Modal>
</Component>