<Component id="ItemsFilter">
  <Signature purpose="Funnel button opening the 'filter by field' picker"
    description="Hides itself when `@itemsFilter` offers no filterable fields, and turns primary once any field is selected. Pair it with ItemsFilterSelectedFields, which renders the per-field value pickers. Takes no props — everything comes from the `@itemsFilter` service."
    group="Data" />

  <div class="relative flex flex-col" If="@itemsFilter.fields.length">

    <IBtn aria-selected="{opened}"
      click="-> opened=!opened"
      mode="{ @itemsFilter.selectedFields.length ? 'primary' : 'outline' }"
      icon="funnel"
    />

    <div class="relative">
      <DropdownOptionsList caption="Filter by..." options="{@itemsFilter.fields}"
        close="-> opened = false"
        multiItemClick="-> @itemsFilter.toggleField(it.value)" If="opened" />
    </div>

  </div>
</Component>