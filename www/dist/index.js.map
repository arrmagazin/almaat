<Component id="SettingsToggleButton">
  <Signature purpose="Gear button that toggles a settings panel"
    description="Circular icon button whose gear rotates while the settings view is open. The open state is owned by the caller: pass it in through `value` and flip it in the `on` handler."
    group="Buttons">
    <Prop id="value" type="boolean" description="Current settings-panel state; rotates the gear icon when true" />
    <Prop id="on" type="action" description="Click handler, normally toggling the caller's settings state" />
  </Signature>
  <button
    title="Toggle settings"
    class="btn btn-ghost btn-circle text-2xl"
    click="{on}">
    <span
      class="icon icon-settings transition duration-300 {value ? 'rotate-90':''}"></span>
  </button>
</Component>