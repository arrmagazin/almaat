<Component id="Field.City">
  <Signature purpose="Country-scoped city picker"
    description="Pairs a country dropdown with a type-ahead city input whose options are narrowed to the chosen country. Use when a record keeps a city and its country in two fields."
    group="Fields">
    <Prop id="value" type="string" description="Selected city name" />
    <Prop id="typeSpec" type="string" description="Key of the sibling country field inside data" />
    <Prop id="data" type="object" description="Whole form record; the country is read from it by the typeSpec key" />
    <Prop id="onChange" type="action" description="Called with the newly selected city" />
    <Prop id="disabled" type="boolean" description="Blocks both the country dropdown and the city input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
    <Prop id="placeholder" type="string" description="Placeholder of the city search box" />
  </Signature>

  <Connector data-country="{data[typeSpec]}" change="->" />

  <Connector data-value="{R.enums.city|find:value|dot:'type' ?? country}"
    change="{onChangeFor[typeSpec]}" />

  <Connector data-citiesByCountry="{R.enums.city|filter:'type': country}" change="->" />

  <TagsValueController Ref="ctrl" value="{value}"
    options="citiesByCountry.length ? citiesByCountry : {R.enums.city}" change="{onChange}"
    disabled="{disabled}" />

  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}"
    disabled="{disabled}">

    <div
      class="inline-flex flex-no-wrap items-center justify-center w-min-10 h-10
  rounded-l-md border border-r-0 text-gray-900 bg-gray-200 border-gray-300 
  dark:bg-gray-600 dark:text-gray-400 dark:border-gray-600">
      <Dropdown options="{R.enums.country}" value="{data[typeSpec]}" change="{onChangeFor[typeSpec]}"
        disabled="{disabled ?? value|truthy}" />
    </div>

    <Field.Suggestion-Input caption="{caption}" class="rounded-r-lg" value="{value}"
      kliuq="@ctrl.kliuq" tags="@ctrl.selectedOptions" placeholder="{placeholder}"
      options="@ctrl.availableOptions" disabled="{disabled}"
      toggleOption="-> @ctrl.toggleAndClearKliuq" />

  </FieldItem>

</Component>