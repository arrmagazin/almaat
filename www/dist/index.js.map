<Component id="Heading">
  <Signature purpose="Section heading with optional icon"
    description="Semantic heading element with level-based sizing (1=largest to 5=smallest). Supports optional leading icon. Use for section titles, page headers, or content hierarchy."
    group="Typography">
    <Prop id="text" type="string" description="Heading text content" />
    <Prop id="level" type="enum" enum="1,2,3,4,5"
      description="Heading level: 1=4xl, 2=3xl, 3=2xl, 4=xl, 5=lg" />
    <Prop id="icon" type="string" description="Optional Lucide icon name" />
  </Signature>
  <div
    class="flex items-center gap-2 font-semibold 
  {level == 1 ? 'text-4xl' : level == 2 ? 'text-3xl' : level == 3 ? 'text-2xl' : level == 4 ? 'text-xl' : 'text-lg'} 
  {level == 1 ? 'opacity-60' : level == 2 ? 'opacity-70' : level == 3 ? 'opacity-80' : level == 4 ? 'opacity-90' : 'opacity-100'} 
  {class}">
    <div class="icon icon-{icon}" If="icon"></div>
    <span>{text}</span>
  </div>
</Component>
