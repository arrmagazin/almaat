<Component id="Loading">
  <Signature purpose="Animated loading indicator"
    description="Displays animated loading spinner/indicator during async operations. Multiple animation styles available. Use while fetching data, submitting forms, or any pending operation."
    group="Feedback">
    <Prop id="type" type="enum" enum="spinner,dots,ring,ball,bars,infinity" default="spinner" description="Animation style" />
    <Prop id="mode" type="enum" enum="primary,secondary,accent,info,success,warning,error" description="Color variant" />
    <Prop id="size" type="enum" enum="xs,sm,md,lg,xl" description="Indicator size" />
    <Prop id="title" type="string" description="Accessible title/tooltip" />
  </Signature>
  <div
    title="{title}"
    aria-role="status"
    class="loading {arrayJoin(arrayPrefixAll('loading-', type ?? 'spinner', mode, size),' ')}"
  >
</div>
</Component>