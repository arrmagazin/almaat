<Component id="Grid">
  <Signature purpose="CSS Grid container with custom column template"
    description="CSS Grid layout container with configurable column template. Use for table-like layouts, dashboards, or any two-dimensional grid arrangements. Prefer Bar/View for simple flex layouts."
    group="Layout">
    <Prop id="cols" type="string" default="auto"
      description="CSS grid-template-columns value (e.g., '1fr 2fr', 'repeat(3, 1fr)', '100px auto 100px')" />
    <Prop id="rows" type="string" description="CSS grid-template-rows value" />
    <Prop id="click" type="action" description="Click handler for the grid container" />
    <Prop id="data" type="any" description="Data payload for click handler" />
    <Slot name="default" description="Grid items/cells" />
  </Signature>
  <div
    class="grid {class}"
    style="grid-template-columns:{cols ?? 'repeat(auto-fill,minmax(15rem,1fr))'};{rows ? 'grid-template-rows:'+rows : ''};"
    click="{click}"
    data="{data}"
  >
    <Slot />
  </div>
</Component>