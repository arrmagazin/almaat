<Component id="TableRowGroupCaption">
  <Signature purpose="Caption of a Table row group"
    description="Shows the group label followed by the number of records it holds. TableRowGroup renders it inside the sticky caption band; use it directly only when building a custom group row."
    group="Table">
    <Prop id="value" type="string" description="Group label; falls back to a dash when empty" />
    <Prop id="data" type="object" description="Group record; its `items` length is shown in brackets" />
  </Signature>
  <div class="line-clamp-1 font-semibold w-full truncate px-2 py-1">{value|| '--'}
    ({data.items.length})</div>
</Component>
