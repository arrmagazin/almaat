<Component id="Stub">
  <Signature purpose="Empty state placeholder with icon and message"
    description="Centered placeholder for empty states, error pages, or 'no data' scenarios. Displays icon, title, subtitle, and optional action slot. Use when lists are empty, searches return no results, or features are unavailable."
    group="Feedback">
    <Prop id="icon" type="string"
      description="Lucide icon name for visual indicator (e.g., 'inbox', 'search', 'alert-circle')" />
    <Prop id="title" type="string" description="Main message headline (e.g., 'No items found')" />
    <Prop id="subtitle" type="string" description="Secondary explanatory text" />
    <Slot name="default" description="Action buttons or additional content" />
  </Signature>

  <Container>
    <div class="w-full py-4 gap-4 flex flex-col items-center text-center rounded-md {class}">
      <div class="mx-4 text-base-content/30 text-7xl" If="icon">
        <div class="icon icon-{icon}" />
      </div>
      <h2 class="text-xl font-semibold mb-2" If="title">{title}</h2>
      <h5 class="text-base-content/60 mb-2" If="subtitle">{subtitle}</h5>
      <span class="m-4" If="Slot()">
        <Slot />
      </span>
    </div>
  </Container>
</Component>