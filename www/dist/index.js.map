<Component id="Tabs">
  <Signature purpose="Horizontal tab navigation bar"
    description="Pill-style tab buttons for switching between views or sections. Selected tab is highlighted. Use for content filtering, view switching, or section navigation within a page."
    group="Navigation">
    <Prop id="items" type="array" required="true" description="Array of {id, name, icon?} tab objects" />
    <Prop id="value" type="any" description="Currently selected tab ID" />
    <Prop id="change" type="action" required="true" description="Tab selection handler receiving data-value" />
    <Prop id="itemClass" type="string" description="Additional CSS classes for each tab button" />
    <Slot name="default" description="Additional content after tabs (e.g., action buttons)" />
  </Signature>
  <div class="flex flex-no-wrap items-center py-1 pr-2 {class}">
    <ul class="flex flex-1 flex-wrap items-center gap-1 -mb-px">
      <li Each="item of items">
        <a data-value="{item.id}"
          aria-selected="{item.id == value}"
          class="btn btn-sm rounded-full 
          {item.id == value?'btn-primary':'btn-soft'} 
          {itemClass}"
          click="{change}">
          <span class="icon icon-{item.icon}" If="item.icon"></span>
          <span class="">{item.name ?? item.id}</span>
        </a>
      </li>
    </ul>
    <Slot />
  </div>
</Component>