<Component id="MDCodespan.Enum">
  <Signature purpose="Inline enum picker rendered from an `enum:…` code span"
    description="Branch of MDCodespan for the `enum:NAME:VALUE` code-span pattern. Turns the code span into a small inline dropdown over the named enum from R.enums, so a document can offer a choice in the middle of a sentence."
    group="Markdown">
    <Prop id="key" type="string" description="Name of the enum in R.enums to list" />
    <Prop id="value" type="string" description="Initially selected option id; defaults to the enum's first option" />
  </Signature>
  <Dropdown size="xs" class="inline"
    triggerClass="px-1 py-0!"
    options="{R.enums[key]}"
    change="-> value = event.value"
    value="{value ?? R.enums[key].0.id}" />
</Component>
