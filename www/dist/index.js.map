<Component id="MDEscape">
  <Signature purpose="Backslash-escaped character in markdown text"
    description="Emitted by the markdown renderer for an `escape` token (`\\*`, `\\_`, …). Renders the literal character with a slight emphasis instead of letting it act as markup."
    group="Markdown">
    <Prop id="text" type="string" description="The escaped character" />
  </Signature>
  <b class="inline-block mx-1 px-1">{text}</b>
</Component>
