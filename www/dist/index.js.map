<Component id="Dropdown">
  <Signature purpose="Expandable selection menu with customizable trigger"
    description="Click-to-open dropdown menu for single-value selection from a list. Features customizable trigger button, option highlighting, and error state for invalid values. Use for enum selectors, status pickers, or any single-choice from options list."
    group="Inputs">
    <Prop id="options" type="array" required="true"
      description="Array of {id, name, symbol?, disabled?} option objects" />
    <Prop id="value" type="any" description="Currently selected option ID" />
    <Prop id="change" type="action" required="true"
      description="Selection handler receiving data-value of chosen option" />
    <Prop id="placeholder" type="string" description="Text shown when no value selected" />
    <Prop id="caption" type="string" description="Header title in options panel" />
    <Prop id="disabled" type="boolean" description="Disable interaction" />
    <Prop id="size" type="enum" enum="xs,sm,md" description="Trigger button size" />
    <Prop id="triggerClass" type="string" description="Additional CSS classes for trigger button" />
    <Prop id="triggerComponent" type="string"
      description="Custom trigger component ID (default: Dropdown-Trigger)" />
    <Prop id="data" type="any" description="Data payload passed to change handler" />
    <Slot name="optionsHeader" description="Content above options list" />
  </Signature>

  <Subcomponent id="Trigger">
    <div
      aria-disabled="{disabled}"
      disabled="{disabled}"
      title="{currentOption.name || value || placeholder}"
      class="group relative rounded-full btn 
        {opened ? 'btn-active rounded-br-none' : 'btn-ghost'}
        {currentOption.name ?'':'text-base-content/70'}
        {currentOption.isErroneous OR (value AND !currentOption.id) ? 'btn-soft btn-error' : ''}
        {class}
        {currentOption.style}
        "
      click="{click}">
      <span class="flex-1 no-wrap truncate ellipsis">{currentOption.symbol} { currentOption.shortName || currentOption.name || value || placeholder}</span>
    </div>
  </Subcomponent>

  <div class="{class}">
    <Dynamic As="{triggerComponent ?? 'Dropdown-Trigger'}"
      class="{arrayJoin(arrayPrefixAll('btn-', size, mode??'outline'),' ')} {triggerClass}"
      opened="{opened}"
      disabled="{disabled}"
      click="-> opened=!opened"
      currentOption="{options | find : value}"
      value="{value}"
      placeholder="{value || placeholder || caption}" />

    <DropdownOptionsList If="opened" 
      options="{options}"
      value="{value}"
      data="{data}"
      close="-> opened=false"
      caption="{caption}"
      itemClick="{change}"
      class="mt-2">
      <Slot Key="optionsHeader" />
    </DropdownOptionsList>
  </div>
</Component>
