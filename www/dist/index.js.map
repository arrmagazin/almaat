<Component id="Checkbox">
  <Signature purpose="Boolean toggle input with label"
    description="Checkbox input with ternary logic. Supports indeterminate state with null/undefined value. Use for single boolean options, terms acceptance, or feature toggles."
    group="Inputs">
    <Prop id="value" type="any"
      description="Current state: true=checked, false=unchecked, null/undefined=indeterminate" />
    <Prop id="title" type="string" description="Label text displayed next to checkbox" />
    <Prop id="change" type="action" required="true"
      description="Toggle handler called on state change" />
    <Prop id="disabled" type="boolean" description="Disable user interaction" />
    <Prop id="id" type="string" description="Input ID for label association" />
  </Signature>
  <label
    class="flex items-center gap-3 cursor-pointer {disabled ? 'opacity-50 cursor-not-allowed' : ''} {class}"
    for="{id}">
    <input id="{id}" type="checkbox" class="checkbox {value == null ? 'opacity-50' : ''}"
      disabled="{disabled}" indeterminate="{value == null}" checked="{value == null ? '' : !!value}"
      toggle="{change}" />
    <span>{title}</span>
  </label>
</Component>