<Component id="ListGroupBy">
  <Signature purpose="Dropdown that picks the grouping field of a collection"
    description="Toggle button plus an options dropdown for choosing which property a collection view groups by, with a clear button once a value is set. Put it in the toolbar of a Table, ListView or Pivot. It renders nothing until options are supplied."
    group="Data">
    <Prop id="data" type="array"
      description="Groupable options, each with an id and a display name" />
    <Prop id="value" type="string" description="Id of the option currently grouped by" />
    <Prop id="onChange" type="action"
      description="Fires with the picked option id; an empty value means the grouping was cleared" />
  </Signature>
  <div class="{class}" If="data">

    <IBtn icon="list-tree" aria-selected="{opened}"
      title="Group by"
      click="-> opened=!opened"
      mode="{value ? 'primary' : 'outline' }" />
    <div class="{opened ? 'relative' : ''}">
      <DropdownOptionsList
        caption="Group by"
        options="{data}"
        itemClick="{onChange}"
        value="{value}"
        close="-> opened=false" If="opened">
        <Btn Slot="btn" If="value" title="Clear" class="px-1 py-1"
          data-value=""
          action="{onChange}"
          afterAction="-> opened=false"
        />
      </DropdownOptionsList>
    </div>
  </div>
</Component>