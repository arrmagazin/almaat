<Component id="ListView">
  <Signature purpose="Scrolling list of records with search and sorting"
    description="Renders a collection as stacked cards, filters it through a keyword box, sorts it through an embedded ListSortBy and extends the page by 50 items as the user scrolls. Use it for plain record lists; use Table when the data needs columns."
    group="Data">
    <Prop id="data" type="array" description="Records to render" />
    <Prop id="filterProp" type="string"
      description="Record field the keyword box searches; the box only appears when it is set" />
    <Prop id="sortOptions" type="array"
      description="Sort options offered by the embedded ListSortBy; omit it to hide the control" />
    <Prop id="itemAs" type="string" description="Component id rendering one item"
      default="ListView-Item" />
    <Prop id="itemClass" type="string" description="Extra CSS classes for each item" />
    <Prop id="listClass" type="string" description="Extra CSS classes for the list container" />
    <Prop id="params" type="object" description="Extra parameters forwarded to every item" />
    <Prop id="onItem" type="action" description="Fires with the record when an item is clicked" />
    <Slot name="default" description="Toolbar content shown to the left of the search box" />
    <Slot name="noData" description="Replaces the built-in empty-state stub" />
  </Signature>

  <Connector data="{newLimit ?? 50}" change="-> limit" />

  <Connector
    data="{data | filterByKeyword : kliuq : filterProp  | slice : 0 : limit | arraySortBy: sortBy}"
    change="-> actualItems" />

  <div class="flex flex-col items-stretch gap-2 w-full {class}">
    <div class="flex items-center gap-2 mx-2 my-2"
      If="(sortOptions || kliuq != undefined) AND data.length > 1">
      <div class="flex-auto w-0 flex items-center">
        <Slot />
      </div>
      <Bar class="relative" If="filterProp AND kliuq != undefined AND data.length > 5">
        <input class="input bg-base-100 rounded-full w-48 flex-auto h-10 pr-10"
          type="text"
          placeholder="Поиск по '{filterProp}'"
          keypress="-> kliuq = event.value"
          change="-> kliuq = event.value"
          value="{kliuq}" />
        <!-- decorative adornment: no handler, so keep it out of the tab order and the a11y tree -->
        <button type="button" tabindex="-1" aria-hidden="true"
          class="btn btn-circle btn-ghost absolute right-0">
          <Icon icon="Search" class="h-6 w-6" />
        </button>
      </Bar>
      <ListSortBy data="{sortOptions}" onChange="-> sortBy= event.value" value="{sortBy}" />
    </div>

    <div class="m-2" If="!data">
      <Loading />
    </div>

    <Fragment If="data.length==0">
      <Fragment If="Slot(noData)">
        <Slot Key="noData" />
        <Else>
          <Stub title="No data found"></Stub>
        </Else>
      </Fragment>
    </Fragment>


    <div class="m-2 cursor-pointer" click="-> kliuq = kliuq | slice:0:-1"
      If="kliuq AND data.length AND !actualItems.length">❌ None found by
      "{kliuq}"</div>

    <div If="actualItems.length" role="list" class="flex flex-col gap-2 min-h-0 {listClass} w-full"
      style="min-height:2rem; min-width: 10rem;"
      scrolledDown="-> newLimit = newLimit ?? 50 | plus: 50">

      <Dynamic As="{itemAs ?? 'ListView-Item'}"
        Props="{item}"
        onItem="{onItem}"
        class="{itemClass}"
        data="{item}"
        sortBy="{sortBy}"
        params="{params}"
        Each="item of actualItems" />
      <div style="min-height:2rem"> </div>

    </div>
  </div>

  <Subcomponent id="Item">
    <div class="card card-info {class}" title="{title}" data="{data}" click="{onItem}">
      <div class="alert flex-1 min-w-0">
        <div class="text-lg font-medium truncate">
          <span class="truncate break-words">{name ?? '--'}</span>
        </div>
        <p class="badge badge-outline badge-info" If="sortBy AND sortBy != 'name'">{sortBy}</p>
      </div>
    </div>
  </Subcomponent>

</Component>