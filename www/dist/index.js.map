<Component id="DarkModeToggler">
  <Signature purpose="Icon button that flips the light and dark theme"
    description="One-tap color scheme switch: shows a sun or moon icon and rotates as it toggles. Put it in a header or toolbar; it takes no props and drives the themeService Ref, which must be in scope."
    group="Buttons" />

  <IBtn
    class="transition-transform duration-500 {@themeService.isDarkMode ? 'rotate-180' : 'rotate-0'}"
    click="-> @themeService.toggle()"
    size="xl"
    icon="{@themeService.isDarkMode ? 'icon-moon-star' : 'sun'}"
    title="{@themeService.isDarkMode ? 'Enter the Light' : 'Enter the Darkness'}"
  />
</Component>