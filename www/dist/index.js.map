<Component id="App">
  <Signature purpose="Root shell of a docs site"
    description="The whole docs-site application in one component: it mounts storage, navigation and DocsService, then lays out the collapsible docs sidebar next to the rendered markdown of the document named by the nav `doc` param. Takes no props — configure it through R.app and R.docsServiceProps."
    group="Books" />
  <LocalStorage Ref="localStorage" />
  <StoredData Ref="treeState" />
  <NavigationService Ref="nav" />
  <BrowserService Ref="browser" />
  <DropdownsPlugin />

  <div class="flex flex-col h-screen" If="{@nav.isReady}">
    <DocsService Ref="docs" Props="{R.docsServiceProps}" doc="{@nav.params.doc??'welcome.md'}" />
    <div class="flex flex-col md:flex-row flex-1 min-h-0">
      <DocsSidebar params="{R.app}" />
      <main class="flex-1 overflow-y-auto bg-base-100">
        <Skeleton If="{@docs.loading}" />
        <div class="flex-1">
          <ErrorMessage
            If="@docs.error"
            error="@docs.error"
            class="m-4 truncate"
            close2="-> @docs.error=false" />
        </div>
        <MarkdownView
          If="{!@docs.loading}"
          text="{@docs.text}"
          key="{@nav.params.doc??'welcome.md'}"
          class="p-6 max-w-4xl mx-auto" />
      </main>
    </div>
  </div>
</Component>
