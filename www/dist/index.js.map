<Component id="TableRow">
  <Signature purpose="One record row of a Table"
    description="Renders a single record across the Table's subgrid: the select checkbox and drag handle, the pinned first column, then one typed TableCell per remaining column. Table instantiates it per item, so set it as `rowComponent` only when replacing the default row layout."
    group="Table">
    <Prop id="data" type="object" description="The record to render; every column reads its value off this object" />
    <Prop id="col1" type="object" description="Spec of the pinned first column, as passed down by Table" />
    <Prop id="cols" type="array" description="Specs of the remaining columns, each {id, type, class, width}" />
    <Prop id="firstColType" type="string" description="Overrides the cell type of the first column; falls back to col1.type, then FirstCol" />
    <Prop id="cellChange" type="action" description="Table `cellChange` handler, forwarded to every editable cell" />
    <Prop id="onItem" type="action" description="Table `onItem` handler, forwarded to the first-column cell to open the record" />
    <Slot name="default" description="Extra content injected into the first-column cell, before its value" />
  </Signature>
  <!-- Rows sit on the page surface (base-100) with a base-300 hairline grid, so the
       sticky header / group captions (base-300) stay the darker, distinct band. -->
  <div
    class="grid grid-cols-subgrid gap-0 col-span-full bg-base-100 border-t border-base-300"
  >
    <div
      class="border border-base-300/60
        z-10
        sticky left-0 bg-base-100
        snap-start flex items-center justify-center"
    >
      <input type="checkbox"
        class="checkbox checkbox-sm"
        If="@tableMultiSelect.enabled"
        checked="{@tableMultiSelect.isSelected[data.id]}"
        change="-> @tableMultiSelect.toggleSelection(data.id)" />
      <button type="button"
        class="btn btn-ghost btn-small rounded-sm cursor-move dragAnchor"
        title="Drag to reorder"
        aria-label="Drag to reorder"
        dragdropType="reorder"
        draggable="{!@tableOrdering.disabled}"
        dragAnchor="dragAnchor"
        dragClass="text-white"
        dragoverClass="border-t-primary"
        data-id="{data.id}"
        dragdrop="-> @tableOrdering.reorderItems(
                objectCreate()
                |assignKeyValue : 'toId' : event.target.id
                |assignKeyValue : 'fromId' : event.source.id
                )"
        If="!@tableOrdering.disabled"
      >::</button>
    </div>
    <div
      class="border border-base-300/60 bg-base-100
    z-10 sticky left-8
    snap-start
    line-clamp-1">
      <Dynamic As="TableCell.{firstColType || col1.type || 'FirstCol' | capitalize}"
        Props="{col1}"
        value="{data | dot:col1.id}"
        data="{data}"
        change="{cellChange}"
        onItem="{onItem}">
        <Slot />
      </Dynamic>
    </div>

    <div
      class="border border-base-300/60
        snap-start p-0 overflow-hidden line-clamp-4 {col.class}"
      Each="col of cols" title="{data[col.id]}">
      <Dynamic As="TableCell.{col.type | capitalize}"
        Props="{col}"
        value="{data[col.id]}"
        data="{data}"
        change="{cellChange}" />
    </div>
  </div>
</Component>
