<Component id="ToastList">

  <Signature purpose="Fixed overlay rendering the queued toasts from @toaster"
    description="Mount once near the app root. Each item in `@toaster.items` becomes an alert with a countdown bar, a copy-to-clipboard button and an optional dismiss; hovering a message calls its `stop` handler to hold it open. The two props only reposition the container — the toasts themselves come from the service."
    group="Feedback">
    <Prop id="class" type="string" description="Extra classes on the fixed container, to move it away from the default top-right corner" />
    <Prop id="style" type="string" description="Inline style on the fixed container, for offsets a class cannot express" />
  </Signature>

  <Subcomponent id="ListItem">
    <div
      class="alert {level=='error'?'alert-error':'alert-success'}
        flex gap-2 p-2 w-full max-w-sm shadow overflow-hidden relative transition-opacity duration-500"
      style="opacity:{progress LT 50 ? 1 :  1 - progress / 100 }"
      role="alert">
      <Bar>
        <b If="counter > 1" class="text-sm">[x{counter}]</b>
        <View class="text-sm font-normal gap-1 p-1 flex-1 overflow-hidden">
          <span class="{expireAt?'line-clump-3':''}" click="{stop}">{message}</span>
          <span class="{expireAt?'line-clump-3':''}" click="{stop}">{details}</span>
          <a class="font-bold ml-2" href="{link}" target="_blank" If="link">link</a>
        </View>
        <Bar>
          <button
            class="btn btn-circle btn-ghost btn-sm icon icon-clipboard"
            click="-> @browser.copyToClipboard(message+(details?': '+details:''), true)"
          />
          <div If="close">
            <button class="btn btn-circle btn-ghost btn-sm icon icon-x" click="{close}" />
          </div>
        </Bar>
      </Bar>
      <div
        class="absolute bottom-0 left-0 h-1 {level=='error'?'bg-red-200':'bg-green-200'} transition-all transition-easy-out duration-250"
        style="width:{progress}%" />
    </div>
  </Subcomponent>

  <div class="fixed top-16 max-sm:left-4 sm:right-4 z-50 {class}"
    style="{style}"
    If="@toaster.items.length">
    <div style="max-width: 600px;margin: auto;">
      <This-ListItem Props="{toast}" Each="toast of @toaster.items" />
    </div>
  </div>
</Component>