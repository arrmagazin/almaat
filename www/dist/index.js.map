<Component id="Field.Password">
  <Signature purpose="Masked password field"
    description="Thin wrapper over Field with a password input type and a dotted placeholder. Use for credential entry in sign-in and profile forms."
    group="Fields">
    <Prop id="id" type="string" description="Field id; becomes the input name" />
    <Prop id="value" type="string" description="Current password text" />
    <Prop id="onChange" type="action" description="Called with the new password" />
    <Prop id="disabled" type="boolean" description="Blocks editing" />
    <Prop id="placeholder" type="string" default="••••••••" description="Placeholder of the input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <Field id="{id}" caption="{caption}" error="{error}" required="{required}" hint="{hint}"
    inputType="password" disabled="{disabled}"
    placeholder="{placeholder ?? '••••••••'}" value="{value}" onChange="{onChange}" />
</Component>
