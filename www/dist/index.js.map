<Component id="BtnLink">
  <Signature purpose="Hyperlink styled as a button"
    description="Anchor element with button-link styling for navigation. Use for links that should appear inline like text links but maintain button semantics. Ideal for 'Learn more', 'View details' type actions."
    group="Buttons">
    <Prop id="href" type="string" required="true" description="Navigation URL" />
    <Prop id="text" type="string" description="Link text label" />
    <Slot name="default" description="Custom link content (alternative to text prop)" />
  </Signature>

  <a class="btn btn-link {class}" href="{href}" target="{target || ''}">
    <span If="text">{text}</span>
    <Slot />
  </a>
</Component>