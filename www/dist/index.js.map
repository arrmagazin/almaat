<Component id="Field.MultiEnum">
  <Signature purpose="Multi-select over an enum with a keyword filter"
    description="Shows the chosen options as badges and opens a filterable option list for toggling them. Use for closed value sets where several values may be selected at once."
    group="Fields">
    <Prop id="value" type="array" description="Selected option ids" />
    <Prop id="typeSpec" type="string" description="Key into R.enums naming the option list" />
    <Prop id="onChange" type="action" description="Called with the updated selection; when absent the list never opens" />
    <Prop id="disabled" type="boolean" description="Keeps the option list closed and hides the toggle indicator" />
    <Prop id="caption" type="string" description="Field label, repeated as the option list heading" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <Subcomponent id="Options">
    <Connector
      data="{options | filterByKeyword : kliuq | arraySortBy:'name' | arraySortBy:'-isSelected'}"
      change="-> filtered" />

    <DropdownOptionsList
      caption="{caption}"
      options="{filtered}"
      close="{close}"
      itemClick="-> @ctrl.doToggleAndClearKliuq()"
      multiItemClick="-> @ctrl.doToggle()">
      <View class="pt-2">
        <Btn Slot="btn" size="sm" title="Clear" action="{clear}" />

        <Bar class="relative" If="options.length > 10">
          <input type="text"
            class="input pl-2 h-10 w-full"
            value="{kliuq}"
            placeholder="filter by..."
            keypress="-> kliuq = event.value" />
          <IBtn size="sm" icon="stop" mode="soft"
            class="absolute right-1"
            click="-> kliuq = ''"
          />
        </Bar>

        <div class="px-2 cursor-pointer" click="-> kliuq = slice(kliuq,0,-1)" If="!filtered.length">❌
          None found by key
          "{kliuq}"</div>
      </View>
    </DropdownOptionsList>
  </Subcomponent>

  <TagsValueController Ref="ctrl" value="{value}" options="{R.enums[typeSpec]}"
    change="{onChange}" disabled="{disabled}" multi="true" />

  <Connector data="@ctrl.evaluatedOptions" change="-> options" />

  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}">
    <div class="relative flex-1 w-0">
      <div
        class="input rounded-md pl-1 pr-1 bg-base-100 w-full! min-h-10 h-fit! relative
          {!disabled AND onChange ? 'cursor-pointer'}
          flex-1 flex items-center flex-no-wrap"
        click="-> opened = !opened">

        <div class="flex-1 flex items-center flex-wrap gap-1 p-1">
          <div
            class="badge truncate {tag.isErroneous ? 'badge-error' : 'badge-accent'}"
            Each="tag of @ctrl.selectedOptions">{tag.name}</div>
        </div>

        <!-- Indicator only: `close` is not a prop of this component, so the handler that used to
             sit here never fired. The click bubbles to the wrapper's `-> opened = !opened` above,
             so adding a second toggle here would cancel it out. -->
        <IBtn icon="{opened ? 'Cross':'BulletsList'}"
          size="sm"
          If="onChange AND !disabled AND options.length" />
      </div>

      <Field.MultiEnum-Options
        caption="{caption}"
        options="@ctrl.evaluatedOptions"
        close="-> opened=false"
        clear="-> value=''"
        If="opened AND !disabled" />
    </div>
  </FieldItem>
</Component>