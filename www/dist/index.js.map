<Component id="FieldItem">
  <Signature purpose="Label, hint and error frame around a field control"
    description="The shared field chrome: caption, required marker, hint popover and error line. Wrap any custom control in it so it lines up with the rest of a form."
    group="Fields">
    <Prop id="caption" type="string" description="Label text above the control; also its title tooltip" />
    <Prop id="required" type="boolean" description="Shows the red asterisk next to the caption, unless disabled" />
    <Prop id="disabled" type="boolean" description="Dims the caption and suppresses the required marker" />
    <Prop id="hidden" type="boolean" description="Hides the whole field frame" />
    <Prop id="error" type="string" description="Validation message rendered under the control" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
    <Prop id="class" type="string" description="Extra classes for the caption and control column" />
    <Slot name="default" description="The field control itself" />
    <Slot name="header" description="Extra content placed on the caption row, right of the required marker" />
  </Signature>
  <div class="grid-cols-1 {hidden | ternaryIf : 'hidden'}">
    <div class="flex flex-col {class} gap-1">
      <div class="w-full flex justify-start gap-1">
        <div
          class="inline-block {disabled ? 'text-base-content/50':'text-base-content/75'} 
              text-start text-xs font-semibold text-ellipsis capitalize"
          title="{caption}">{caption}</div>
        <div If="!disabled AND required" class="text-red-500" style="font-size:0.6rem;">✱</div>
        <Slot Key="header" />
      </div>
      <div class="flex items-center gap-2">
        <Slot />
        <Popover icon="info" popoverClass="border" If="hint">
          <div class="btn btn-circle btn-ghost text-gray-500/80 icon icon-info" />
          <div class="max-w-96" Slot="popover">
            {hint}</div>
        </Popover>
      </div>
    </div>
    <div class="ml-48 mt-2 max-sm:ml-0 w-full" If="error">
      <p class="text-orange-500 mb-1">{error}</p>
    </div>
  </div>
</Component>