<Component id="TableCell">
  <Signature purpose="Default text cell of a Table row"
    description="Renders a column value as clamped text, or as an inline editor when the row supplies a change handler. It is the fallback `TableCell.*` a TableRow picks when the column declares no type."
    group="Table">
    <Prop id="value" type="string" description="Value of this column for the row" />
    <Prop id="data" type="object" description="The whole row record; its id is stamped on the editor as data-id" />
    <Prop id="id" type="string" description="Column id, stamped on the editor as data-field" />
    <Prop id="change" type="action" description="Table `cellChange` handler; when absent the cell stays read-only" />
    <Prop id="disabled" type="boolean" description="Keeps the cell read-only even when a change handler is given" />
  </Signature>
  <Fragment If="change AND !disabled">
    <Then>
      <input class="w-full h-full transparent px-2 py-1"
        value="{value}"
        data-id="{data.id}"
        data-field="{id}"
        enter="{change}"
        change="{change}" />
    </Then>
    <Else>
      <div class="line-clamp-2 w-full truncate px-2 py-1">{value}</div>
    </Else>
  </Fragment>
</Component>
