<Component id="Logo">
  <Signature purpose="Application logo image"
    description="Circular logo image with automatic fallback to app config (R.app.logo) or default assets/logo.png. Use in headers, navigation, or branding areas."
    group="Media">
    <Prop id="url" type="string" description="Logo image URL (falls back to R.app.logo or assets/logo.png)" />
    <Prop id="size" type="string" default="10" description="Logo diameter in Tailwind units (e.g., '8', '12', '16')" />
    <Prop id="title" type="string" description="Tooltip text (falls back to R.app.name)" />
  </Signature>
  <img class="h-{size ?? '10'} w-{size ?? '10'} min-w-{size ?? '10'} rounded-full"
    src="{url ?? R.app.logo ?? 'assets/logo.png'}"
    title="{title ?? R.app.name}" />
</Component>