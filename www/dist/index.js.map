<Component id="TableCell.Url">
  <Signature purpose="Link cell of a Table row"
    description="Renders each comma-separated value as an external link, with the scheme stripped from the label. Give the column a typeSpec template to build the href from other row fields instead of the value itself. A TableRow picks it for columns with type `url`."
    group="Table">
    <Prop id="value" type="string" description="One URL, or several separated by commas" />
    <Prop id="typeSpec" type="string" description="Optional href template formatted against the row record; without it the value itself is the href" />
    <Prop id="data" type="object" description="The whole row record, used to fill the typeSpec template" />
  </Signature>
  <div class="w-full truncate max-w-80 px-2 py-1">
    <a Each="val of stringSplit(value)"
      class=" px-2 py-1"
      target="_blank"
      href="{typeSpec ? stringFormat(typeSpec, data) : strReplace(val.id, 'https:', '')}"
      style="padding-left: 0px">
      {strReplace(val.id, 'https://', '')}
    </a>
  </div>
</Component>
