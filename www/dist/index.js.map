<Component id="Img">
  <Signature purpose="Image with placeholder fallback"
    description="Image element with automatic placeholder when src is missing or fails to load. Shows a generic landscape placeholder SVG as fallback. Use for user-generated content, thumbnails, or any image that may be unavailable."
    group="Media">
    <Prop id="src" type="string" description="Image URL; shows placeholder if empty or on error" />
    <Prop id="alt" type="string" description="Alt text for accessibility" />
    <Prop id="fallbackSrc" type="string" description="Custom fallback image URL on load error" />
    <Prop id="loading" type="enum" enum="lazy,eager"
      description="Native lazy-loading hint; defers off-screen fetches when set to 'lazy'" />
    <Prop id="style" type="string" description="Inline CSS styles" />
    <Prop id="click" type="action" description="Click handler for interactive images" />
    <Prop id="data" type="any" description="Data payload for click handler" />
  </Signature>
  <img
    src="{src || 'data:image/svg+xml;base64,'}"
    alt="{alt}"
    class="img {class}"
    style="{style}"
    loading="{loading}"
    data="{data}"
    error="-> src = fallbackSrc"
    click="{click}"
    afterClick="{afterClick}" />
</Component>