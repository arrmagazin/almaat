<Component id="MDDetails">
  <Signature purpose="Collapsible block from a raw &lt;details&gt; container in markdown"
    description="Emitted by the markdown renderer when a document embeds a `details` HTML container. The container's `summary` becomes the clickable header, the remaining markdown its body."
    group="Markdown">
    <Prop id="summary" type="string" description="Header text taken from the container's summary tag" />
    <Slot name="default" description="Markdown content revealed when the block is expanded" />
  </Signature>
  <details class="my-3 border border-base-300 rounded-lg px-4 py-2">
    <summary class="cursor-pointer font-semibold text-sm py-1 select-none">{summary}</summary>
    <div class="pl-4">
      <Slot />
    </div>
  </details>
</Component>
