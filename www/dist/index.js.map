<Component id="Field.Smartarea">
  <Signature purpose="Long text field with insertable snippets"
    description="Shows the text read-only in the form and edits it in a modal offering a palette of clickable snippet chips. Use for templated descriptions assembled from reusable fragments."
    group="Fields">
    <Prop id="value" type="string" description="Current text" />
    <Prop id="typeSpec" type="string" description="Key into R.enums naming the snippet list offered as chips" />
    <Prop id="onChange" type="action" description="Called with the edited text" />
    <Prop id="disabled" type="boolean" description="Renders the text as a static block with no editor" />
    <Prop id="placeholder" type="string" description="Grey text shown in place of an empty value" />
    <Prop id="caption" type="string" description="Field label, repeated as the editor modal header" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
  </Signature>
  <SmartareaController Ref="ctrl" options="{R.enums[typeSpec]}" value="{value}" change="{onChange}" />

  <FieldItem caption="{caption}" error="{error}" required="{required}">
    <Fragment If="disabled">
      <Then>
        <div class="input"
          style="height: auto;min-height:1.5rem;white-space: pre-wrap">{value}</div>
      </Then>
      <Else>
        <div class="input {value ? '' : 'text-gray-400'}" click="-> opened=true"
          style="min-height: 2.5rem;white-space: pre-wrap; ">{value ??
          placeholder}</div>
      </Else>
    </Fragment>

    <Modal open="{opened}" If="opened" close="-> opened=false">
      <Fragment Slot="header">
        <h6>{caption}</h6>
      </Fragment>
      <textarea autofocus="true" class="input h-48" keypress="-> @ctrl.change()"
        value="{value}" />
      <div style="overflow-y: auto;height:10rem;margin:0.5rem 0;">
        <div class="flex w-full flex-wrap gap-2 p-2 bg-gray-200">
          <Chip title="{item.name}"
            Each="item of @ctrl.smartOptions"
            click="-> @ctrl.append(item.id| pack:'value')" />
        </div>
      </div>
      <Fragment Slot="footer">
        <div class="flex justify-between w-full">
          <Btn type="primary" title="OK" action="-> opened=false" />
        </div>
      </Fragment>
    </Modal>
  </FieldItem>
</Component>