<Component id="Container">
  <Signature purpose="Centered responsive page container"
    description="Full-width on mobile, max-width centered container on larger screens (max-w-6xl). Use as main content wrapper for pages to ensure consistent horizontal margins and responsive behavior. Width follows the parent column (w-full), so it stays inside app shells that render a sidebar."
    group="Layout">
    <Prop id="class" type="string" description="Extra classes on the section, appended after the layout defaults" />
    <Prop id="scroll" type="action" description="Scroll event handler" />
    <Prop id="scrolledDown" type="action" description="Handler when scrolled past threshold" />
    <Slot name="default" description="Page content" />
  </Signature>
  <section
    class="w-full relative
    flex flex-col align-stretch gap-2
    md:container md:mx-auto lg:max-w-6xl 
    min-h-0
    {class}"
    scroll="{scroll}"
    scrolledDown="{scrolledDown}">
    <Slot />
  </section>
</Component>