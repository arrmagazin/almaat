<Component id="Field.Url">
  <Signature purpose="URL field with launch buttons"
    description="A text input plus one external-link button per URL held in the value. Use for web links, and for ids that expand into a link through a URL template."
    group="Fields">
    <Prop id="id" type="string" description="Field id; becomes the input name and the base of each link target window" />
    <Prop id="value" type="string" description="URL text; split on whitespace, so several links can share one field" />
    <Prop id="typeSpec" type="string" description="Optional URL template; when set, the link href is built from it and the record instead of the raw value" />
    <Prop id="data" type="object" description="Whole form record, interpolated into the typeSpec URL template" />
    <Prop id="onChange" type="action" description="Called with the new URL text" />
    <Prop id="disabled" type="boolean" description="Blocks editing" />
    <Prop id="placeholder" type="string" default="https://example.com" description="Placeholder of the input" />
    <Prop id="caption" type="string" description="Field label; the word URL is appended to it" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="helper" type="string" description="Prefix content of the field frame" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption} URL" error="{error}" required="{required}" helper="{helper}"
    disabled="{disabled}" hint="{hint}"
    value="{value}">
    <div class=" flex-1 flex items-center relative gap-1">
      <input name="{id}"
        type="text"
        class="input validator w-full! {error ? 'border-red-600'}"
        placeholder="{placeholder ?? 'https://example.com'}"
        value="{value}"
        change="{onChange}"
        disabled="{disabled}" />
      <div
        class="flex flex-no-wrap items-center justify-center w-min-10 gap-1"
        If="value">
        <a Each="url of stringSplit(value)"
          class="btn btn-sm btn-circle icon-external-link"
          href="{typeSpec ? stringFormat(typeSpec, data) : url.id}"
          target="{id}-{url.id}" title="{url.id}"></a>
      </div>

    </div>
  </FieldItem>
</Component>
