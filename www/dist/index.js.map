<Component id="FieldTags.UI">
  <Signature purpose="Row of selectable tag chips"
    description="Pure presentation: renders a tag list as chips and reports which one was clicked. Use to build tag pickers without binding a value controller."
    group="Fields">
    <Prop id="tags" type="array" description="Options to render; each needs id, name and isSelected" />
    <Prop id="click" type="action" description="Called with the clicked tag id, taken from its data-value" />
  </Signature>
  <div class="input w-full flex-1 flex flex-wrap min-h-max pt-2 px-2 space-x-2 rounded-lg">
    <Chip
      title="{tag.name}"
      isSelected="{tag.isSelected}"
      data-value="{tag.id}"
      click="{click}"
      Each="tag of tags" />
  </div>
</Component>
