<Component id="BoardView">
  <Signature purpose="Kanban board of records grouped into draggable lanes"
    description="Pivots a flat list by one or two fields and renders every record as a draggable card inside its group. Use it for status boards and any workflow where dragging a record onto a lane should reassign that field."
    group="Data">
    <Prop id="data" type="array" description="Flat list of records to group into lanes" />
    <Prop id="rowId" type="string" description="Record field whose values become the rows / lanes" />
    <Prop id="colId" type="string"
      description="Record field whose values become the columns; leave it empty for a single-axis board" />
    <Prop id="form" type="object"
      description="Form metadata used while pivoting to resolve field captions and enum labels" />
    <Prop id="itemComponent" type="string"
      description="Component id forwarded to each card for custom rendering" />
    <Prop id="onItem" type="action" description="Click handler forwarded to each card" />
    <Prop id="onItemDrop" type="action"
      description="Fires when a card is dropped on a lane; the drop target carries the field and the value to assign" />
  </Signature>
  <Subcomponent id="Cell">
    <div
      class="group flex gap-2 text-normal font-medium truncate alert alert-info alert-soft"
      data="{data}"
      draggable="true">
      <span class="flex-1 truncate break-words">{data.name || '--'}</span>
    </div>
  </Subcomponent>

  <Subcomponent id="Cluster">
    <div
      class="grid grid-cols-subgrid  col-span-full
      collapse collapse-arrow {opened ?? initialOpened ? 'collapse-open' :'collapse-close'}
      bg-base-200"
    >
      <Bar
        class="sticky top-0 collapse-title font-bold col-span-full"
        dragdrop="{onItemDrop}"
        data-field="{rowId}"
        data-value="{row.id}"
        click="-> opened = !opened"
      >
        <span>{row.name || ' Ø '} ({row.value || ' Ø '})</span>
      </Bar>
      <div If="opened"
        class="grid grid-cols-subgrid col-span-full collapse-content"
        dragdrop="{onItemDrop}"
        data-field="{rowId}"
        data-value="{row.id}"
      >
        <div Each="col of row.columns"
          class="flex flex-col gap-2"
          dragdrop="{onItemDrop}"
          title="{col.name}"
          data-field="{rowId}"
          data-value="{col.id}">

          <BoardView-Cell Each="cell of col.items"
            data="{cell}"
            itemComponent="{itemComponent}"
            onItem="{onItem}" />
        </div>
      </div>
    </div>
  </Subcomponent>

  <Connector
    If="data"
    data="{data}"
    trigger="{data.length}{rowId}{colId}"
    change="-> pivot = pivotData(it, rowId, colId, form, R.enums) | log" />

  <Fragment If="!colId">
    <Then>
      <div class="{class}"
        style="display: grid; grid-template-columns: repeat({pivot.rows.length}, minmax(12rem, 1fr));">
        <div Each="row of pivot.rows"
          class="sticky top-0 w-full bg-base-300 font-bold p-2"
          dragdrop="{onItemDrop}"
          data-field="{rowId}"
          data-value="{row.id}"
        >
          <span>{row.name || ' Ø '} ({row.value || ' Ø '})</span>
        </div>

        <div Each="row of pivot.rows"
          class="p-2 py-2 flex flex-col gap-2"
          dragdrop="{onItemDrop}"
          title="{row.name}"
          data-field="{rowId}"
          data-value="{row.id}"
        >
          <BoardView-Cell Each="cell of row.items"
            data="{cell}"
            itemComponent="{itemComponent}"
            onItem="{onItem}" />
        </div>
      </div>
    </Then>
    <Else>
      <div class="{class}"
        style="display: grid; gap:0.5rem; grid-template-columns: repeat({pivot.columns.length}, minmax(12rem, 1fr));">
        <div Each="col of pivot.columns"
          class="sticky top-0 w-full "
          dragdrop="{onItemDrop}"
          data-field="{colId}"
          data-value="{col.id}"
        >
          <div class="bg-base-200 font-bold p-2">{col.name || ' Ø '} ({col.value || ' Ø '})</div>
        </div>

        <BoardView-Cluster Each="row of pivot.rows"
          row="{row}"
          rowId="{rowId}"
          itemComponent="{itemComponent}"
          onItem="{onItem}"
          onItemDrop="{onItemDrop}" />
      </div>
    </Else>
  </Fragment>


</Component>