<Component id="MDLink">
  <Signature purpose="Hyperlink from markdown link syntax"
    description="Emitted by the markdown renderer for `[text](href)`. The default opens every target in a new tab; a docs site overrides this component to route in-repo links internally."
    group="Markdown">
    <Prop id="href" type="string" description="Link target as written in the document" />
    <Prop id="text" type="string" description="Visible link label" />
  </Signature>
  <a class="inline-block mx-1 px-1 link link-primary"
    href="{href}"
    target="_blank">
    {text}
  </a>
</Component>
