<Component id="MDOrderedList">
  <Signature purpose="Numbered list of a markdown document"
    description="Emitted by the markdown renderer for an ordered list without task markers. Nested lists get the same component one depth level deeper."
    group="Markdown">
    <Prop id="depth" type="number" description="Nesting level; anything above 0 is indented" />
    <Prop id="class" type="string" description="Extra CSS classes for the list" />
    <Slot name="default" description="List items" />
  </Signature>
  <ol class="list-decimal list-inside my-2 space-y-1 text-sm {class} {depth==0?'':'ml-4'}">
    <Slot />
  </ol>
</Component>
