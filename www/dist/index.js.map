<Component id="ScrollView">
  <Signature purpose="Scrollable container with overflow handling"
    description="Container with automatic scrollbar for content overflow. Supports vertical (default) or horizontal scrolling. Use for lists, content areas, or any region that may exceed viewport."
    group="Layout">
    <Prop id="dir" type="enum" enum="vertical,horizontal" default="vertical"
      description="Scroll direction ('horizontal' for x-axis)" />
    <Prop id="style" type="string" description="Additional inline CSS styles" />
    <Prop id="scroll" type="action" description="Scroll event handler" />
    <Prop id="scrolledDown" type="action" description="Handler when scrolled past threshold" />
    <Slot name="default" description="Scrollable content" />
  </Signature>
  <div aria-type="scrollable"
    class="{class}"
    style="min-{dir=='horizontal'?'width':'height'}:0; overflow-{dir=='horizontal'?'x':'y'}:auto; {style}"
    scroll="{scroll}"
    scrolledDown="{scrolledDown}"
  >
    <div class="flex flex-col {innerClass}">
      <Slot />
    </div>
  </div>
</Component>