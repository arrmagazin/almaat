<Component id="Field.DateAndTime">
  <Signature purpose="Date input paired with a free-text time input"
    description="Two controls in one row: a native date picker for this field and a text box for a time kept in a sibling field. Use for appointments stored as separate date and time columns."
    group="Fields">
    <Prop id="value" type="string" description="Date part, bound to the native date input" />
    <Prop id="typeSpec" type="string" description="Key of the sibling time field inside data" />
    <Prop id="data" type="object" description="Whole form record; the time text is read from it by the typeSpec key" />
    <Prop id="onChange" type="action" description="Called with the new date" />
    <Prop id="disabled" type="boolean" description="Blocks the date input; the time box is also blocked while no date is set" />
    <Prop id="placeholder" type="string" description="Placeholder of the date input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}">
    <div class="flex">
      <input type="date" class="input flex-1" disabled="{disabled}"
        placeholder="{placeholder}"
        value="{value}"
        change="{onChange}" />
      <input class="input flex-1 ml-2"
        disabled="{!value OR disabled}"
        type="text"
        value="{data[typeSpec]}"
        change="{onChangeFor[typeSpec]}" />
    </div>
  </FieldItem>
</Component>
