<Component id="MenuButton">
  <Signature purpose="Hamburger button that toggles a navigation menu"
    description="Animated hamburger/close button for mobile navigation. The open state is owned by the caller: pass it in through `opened` and flip it in the click handler."
    group="Navigation">
    <Prop id="opened" type="boolean" description="Current menu state; swaps the hamburger icon for the close icon" />
    <Prop id="click" type="action" description="Click handler, normally toggling the caller's menu state" />
    <Prop id="afterClick" type="action" description="Handler run after the click, for example to close an overlay" />
  </Signature>
  <label
    class="btn btn-circle btn-ghost
      transition duration-300 hover:scale-110
      swap { opened ? 'swap-active' : ''} swap-rotate"
    aria-controls="mobile-menu"
    aria-expanded="{opened}"
    click="{click}"
    afterClick="{afterClick}">
    <!-- hamburger icon -->
    <svg
      class="swap-off fill-current"
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      viewBox="0 0 512 512">
      <path d="M64,384H448V341.33H64Zm0-106.67H448V234.67H64ZM64,128v42.67H448V128Z" />
    </svg>
    <!-- close icon -->
    <svg
      class="swap-on fill-current"
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      viewBox="0 0 512 512">
      <polygon
        points="400 145.49 366.51 112 256 222.51 145.49 112 112 145.49 222.51 256 112 366.51 145.49 400 256 289.49 366.51 400 400 366.51 289.49 256 400 145.49" />
    </svg>
    <span class="sr-only">Main Menu is {opened ?'opened':'closed'}</span>
  </label>
</Component>