<Component id="TableCell.FirstCol">
  <Signature purpose="Pinned first cell of a Table row"
    description="Default cell for the Table's sticky first column: the record label, clickable to open the record. A TableRow picks it when the first column declares no type of its own."
    group="Table">
    <Prop id="value" type="string" description="Label of the record, read off the first column" />
    <Prop id="data" type="object" description="The whole row record; passed to the click handler" />
    <Prop id="onItem" type="action" description="Table `onItem` handler, fired with the record when the label is clicked" />
    <Slot name="default" description="Content placed before the label, such as an expander or avatar" />
  </Signature>
  <div class="flex items-center justify-center">
    <Slot />
    <div class="flex-1 line-clamp-2 truncate max-w-240 px-2 py-1" data="{data}" click="{onItem}">{value}</div>
  </div>
</Component>
