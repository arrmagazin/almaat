<Component id="Input">
  <Signature purpose="Single-line text input field"
    description="Standard text input for user text entry. Supports various input types (text, email, password, number, etc.). Use for form fields, search boxes, or any single-line text input."
    group="Inputs">
    <Prop id="value" type="string" description="Current input value (two-way binding)" />
    <Prop id="change" type="action"
      description="Handler called on value change with event.target.value" />
    <Prop id="placeholder" type="string" description="Placeholder text when empty" />
    <Prop id="type" type="enum" enum="text,email,password,number,tel,url,search" default="text"
      description="HTML input type" />
    <Prop id="name" type="string" description="Input name for form submission" />
    <Prop id="disabled" type="boolean" description="Disable input interaction" />
    <Prop id="autofocus" type="boolean" description="Auto-focus on mount" />
    <Prop id="enter" type="action" description="Handler for Enter key press" />
    <Prop id="keypress" type="action" description="Handler for any key press" />
    <Prop id="input" type="action"
      description="Handler fired live on every input event with event.value (best for live search/filter)" />
    <Prop id="blur" type="action" description="Handler when input loses focus" />
    <Prop id="data" type="any" description="Data payload for event handlers" />
  </Signature>
  <input
    name="{name}"
    type="{type ?? 'text'}"
    class="input {class}"
    placeholder="{placeholder}"
    value="{value}"
    data="{data}"
    change="{change}"
    autofocus="{autofocus}"
    blur="{blur}"
    keypress="{keypress}"
    input="{input}"
    enter="{enter}"
    disabled="{disabled}" />
</Component>