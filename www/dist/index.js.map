<Component id="ListSortBy">
  <Signature purpose="Control that picks the sort field and direction of a collection"
    description="Button plus an options dropdown for choosing the sort property, with an arrow that flips ascending and descending. Put it in the toolbar of a Table or Pivot; ListView already embeds one."
    group="Data">
    <Prop id="data" type="array"
      description="Sortable options, each with an id and a display name" />
    <Prop id="value" type="string"
      description="Current sort field; a leading minus sign means descending" />
    <Prop id="onChange" type="action"
      description="Fires with the new sort value, minus sign included" />
  </Signature>
  <div class="{class}">

    <button type="button" aria-selected="{opened}"
      title="Sort by"
      aria-label="Sort by"
      class="btn rounded-full {opened ? 'btn-primary' : 'btn-outline' }">
      <Fragment If="!value">
        <div click="-> opened=!opened">
          <div class="h-8 w-8 icon icon-arrow-down-narrow-wide" />
        </div>
        <Else>
          <div
            class="w-8 font-lg icon icon-arrow-down-{value[0] == '-' ? 'wide-narrow' :'narrow-wide'}"
            click="{onChange}"
            data-value="{ value[0] == '-' ? slice(value,1) : '-' + value }">
          </div>
          <span class="capitalize truncate" click="-> opened=!opened">
            { value[0] == '-' ? slice(value,1) : value}
          </span>
        </Else>
      </Fragment>
    </button>

    <div class="{opened ? 'relative' : ''}">
      <DropdownOptionsList
        caption="Sort by"
        options="{narrowItemList(data)}"
        itemClick="{onChange}"
        value="{value}"
        close="-> opened=false"
        If="opened" />
    </div>
  </div>
</Component>