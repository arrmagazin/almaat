<Component id="MDCodespan">
  <Signature purpose="Inline code span of a markdown document"
    description="Emitted by the markdown renderer for `` `code` ``. Splits the text on `:` — an `enum:` prefix renders an inline enum picker, anything else renders as a bordered monospace chip."
    group="Markdown">
    <Prop id="text" type="string" description="Raw text between the backticks" />
  </Signature>
  <This-Impl keys="{stringSplit(text,':')}" text="{text}" />
  <Subcomponent id="Impl">
    <Selector On="{keys[0]}">
      <Case When="enum">
        <MDCodespan.Enum key="{keys[1]}" value="{keys[2]}" />
      </Case>
      <Case When="default">
        <span class="inline-block border mx-1 px-1 rounded text-xs font-mono"
          >
          {text}
        </span>
      </Case>
    </Selector>
  </Subcomponent>
</Component>
