<Component id="MDSection">
  <Signature purpose="Collapsible section built around an H1-H3 heading"
    description="Emitted by the markdown renderer for every heading of level 1-3: the heading becomes the summary and everything up to the next heading of the same or higher level becomes the body. Deeper headings stay plain."
    group="Markdown">
    <Prop id="open" type="boolean" description="Expanded on first render; set for the section before the document's first H1" />
    <Prop id="class" type="string" description="Heading classes chosen for the section's level" />
    <Slot name="title" description="Inline content of the heading" />
    <Slot name="default" description="Block content belonging to the section" />
  </Signature>
  <details open="{open}">
    <summary class="{class}">
      <Slot Key="title" />
    </summary>
    <div class="pl-4">
      <Slot />
    </div>
  </details>
</Component>
