<Component id="Field.Suggestion">
  <Signature purpose="Type-ahead single-choice picker"
    description="Shows the current choice as a chip and opens a searchable option list, accepting the typed keyword as a new value when nothing matches. Use for long enums where scrolling a plain select is impractical."
    group="Fields">
    <Prop id="value" type="string" description="Selected option id" />
    <Prop id="typeSpec" type="string" description="Key into R.enums naming the option list" />
    <Prop id="onChange" type="action" description="Called with the selected value" />
    <Prop id="change" type="action" description="Fallback change handler used when onChange is not supplied" />
    <Prop id="disabled" type="boolean" description="Keeps the option list closed" />
    <Prop id="placeholder" type="string" description="Placeholder of the search box" />
    <Prop id="caption" type="string" description="Field label, repeated as the option list heading" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>

  <Subcomponent id="Input">
    <div class="relative flex-1" style="">
      <div class="input flex items-center cursor-pointer {class}"
        style="min-height: 2.5rem;"
        click="-> opened=!opened">
        <Chip class=""
          title="{find(tags,value).name ?? value}"
          isSelected="{true}"
          click2="-> @ctrl.doReset()"
          If="value">
          <IBtn icon="x" />
        </Chip>
      </div>

      <DropdownOptionsList If="!disabled AND opened"
        caption="{caption}"
        options="{options}"
        close="-> opened=false" itemClick="{toggleOption}">
        <div class="mx-2 my-2 flex gap-1">
          <input type="text"
            autofocus="true"
            class="input flex-1"
            placeholder="{placeholder}"
            enter="-> toggleOption(); opened=false"
            keypress="-> @ctrl.doKliuq()" />
          <Btn title="Clear" mode="ghost"
            disabled="{!truthy(value)}"
            data-value="{value}"
            action="{toggleOption}"
            afterAction="-> opened=false" />
        </div>

        <div class="btn btn-soft btn-primary justify-start px-2 py-1"
          If="!options.length AND kliuq"
          data-value="{kliuq}"
          click="{toggleOption}"
          afterClick="-> opened=false">
          "{kliuq}"
        </div>
      </DropdownOptionsList>
    </div>
  </Subcomponent>

  <TagsValueController Ref="ctrl"
    value="{value}"
    options="{R.enums[typeSpec]}"
    change="{onChange ?? change}"
    disabled="{disabled}" />

  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}">
    <This-Input caption="{caption}"
      class="rounded-lg"
      value="{value}"
      kliuq="@ctrl.kliuq"
      disabled="{disabled}"
      tags="@ctrl.selectedOptions"
      placeholder="{placeholder}"
      options="@ctrl.availableOptions"
      toggleOption="-> @ctrl.doToggleAndClearKliuq()" />
  </FieldItem>

</Component>