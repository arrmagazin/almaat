<Component id="Chip">
  <Signature purpose="Selectable tag or filter item"
    description="Interactive badge-like element for filter chips, tags, or multi-select options. Highlights when selected. Use for tag clouds, filter bars, or selectable categories."
    group="Typography">
    <Prop id="title" type="string" required="true" description="Chip display text" />
    <Prop id="isSelected" type="boolean" description="Highlighted/active state" />
    <Prop id="click" type="action" description="Selection handler" />
    <Prop id="data" type="any" description="Data payload for click events" />
  </Signature>
  <span data="{data}" click="{click}" aria-selected="{isSelected}"
    class="badge { isSelected ? 'badge-accent' : '' }
    {click ? 'cursor-pointer' :''} 
    {class}
    ">
    <span>{title}</span>
  </span>
</Component>