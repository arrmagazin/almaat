<Component id="Field.Date">
  <Signature purpose="Date field with a calendar dropdown"
    description="Shows the stored date as text and opens a CalendarPicker in a dropdown. Use when a calendar surface is wanted instead of a bare native date input."
    group="Fields">
    <Prop id="value" type="string" description="Current date text; also the title of the clickable area" />
    <Prop id="onChange" type="action" description="Called with the date picked in the calendar; when absent the field is read-only" />
    <Prop id="disabled" type="boolean" description="Hides the toggle button and keeps the calendar closed" />
    <Prop id="caption" type="string" description="Field label, repeated in the calendar dropdown header" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}">
    <div
      class="group input w-full! max-w-96 pl-2 pr-1 min-h-10 
      flex-1 flex flex-no-wrap items-center
      {!disabled AND onChange ? 'cursor-pointer'}">

      <div title="{value}" click="-> opened = !opened"
        class=" flex-1 flex flex-wrap gap-1 px-2 truncate h-full items-center">
        <span>{value}</span>
      </div>
      <button
        class="btn btn-circle btn-ghost btn-sm icon icon-{(opened ? 'x':'list')}"
        click="-> opened = !opened"
        If="onChange AND !disabled" />
      <div
        If="opened AND onChange AND !disabled"
        dropdown="-> opened=false"
        class="bg-base-200 relative rounded-box shadow-lg z-50"
        style="min-width: 30rem; width: max-content">
        <CalendarPicker
          value="{value}"
          onChange="{onChange}"
          close="-> opened=false"
        >
          <div class="flex-1 font-bold">📆 {caption}</div>
        </CalendarPicker>
      </div>
    </div>
  </FieldItem>
</Component>
