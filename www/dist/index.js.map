<Component id="IBtn">
  <Signature purpose="Icon-only circular button"
    description="Compact circular button displaying only an icon. Use for toolbar actions, close buttons, or secondary actions where space is limited. Default ghost style."
    group="Buttons">
    <Prop id="icon" type="string" required="true"
      description="Lucide icon name (e.g., 'x', 'plus', 'menu', 'refresh', 'cog')" />
    <Prop id="action" alias="click" type="action" description="Click handler" />
    <Prop id="mode" type="enum" enum="ghost,primary,secondary,accent" default="ghost"
      description="Button style variant" />
    <Prop id="size" type="enum" enum="xs,sm,md,lg,xl" description="Button and icon size" />
    <Prop id="disabled" type="boolean" description="Disable button interaction" />
    <Prop id="data" type="any" description="Data payload for click handler" />
    <Prop id="title" alias="alt" type="string"
      description="Tooltip text; also the accessible name — an icon-only button has no label without it" />
  </Signature>
  <button
    type="button"
    role="button"
    title="{title ?? alt}"
    aria-label="{title ?? alt}"
    disabled="{disabled ?? false}"
    class="btn btn-circle
      icon icon-{icon} text-{size}
      {arrayJoin(arrayPrefixAll('btn-', type, mode ?? 'ghost', size),' ')} {class}"
    data="{data}"
    click="{!disabled ? (action ?? click)}"
    afterClick="{!disabled ? (afterAction ?? afterClick)}">
</button>
</Component>