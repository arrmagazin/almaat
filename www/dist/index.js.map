<Component id="Field.MultiDate">
  <Signature purpose="Multiple dates collected as removable chips"
    description="Holds any number of dates, each shown as a chip that removes itself on click, added through a CalendarPicker dropdown. Use for irregular schedules such as selected working days."
    group="Fields">
    <Prop id="value" type="array" description="Selected dates; each entry renders as one chip" />
    <Prop id="onChange" type="action" description="Called with the updated date list; when absent the add dropdown never opens" />
    <Prop id="disabled" type="boolean" description="Hides the add button and the chip remove icons" />
    <Prop id="class" type="string" description="Extra classes for the chip container box" />
    <Prop id="caption" type="string" description="Field label, repeated in the calendar dropdown header" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <Subcomponent id="Chip">
    <span class="badge badge-accent bagde-sm "
      data-value="{value}"
      click="{!disabled ? action}">
      <span>{value}</span>
      <div class="icon icon-x" If="!disabled" />
    </span>
  </Subcomponent>

  <TagsValueController Ref="tags"
    value="{value}"
    change="{onChange}"
    disabled="{disabled}"
    multi="true" />

  <Connector
    data-value="{newValue}"
    trigger="{newValue}"
    If="newValue"
    change="-> @tags.doToggle(); opened=false"
  />

  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}">

    <div class="relative flex-1" style="">
      <div
        class="input py-1 pr-1 pl-1 w-full 
        rounded-md! h-fit {value ? '' : 'cursor-pointer'} {class} flex items-center gap-1"
        style="min-height: 2.5rem;"
      >
        <div class="flex-1 flex items-center flex-wrap gap-1">
          <Field.MultiDate-Chip
            Each="val of value"
            value="{val.id}"
            disabled="{disabled}"
            action="-> @tags.doToggle()" />
        </div>
        <Btn
          icon="plus"
          size="sm"
          action="-> opened = true"
          If="!disabled" />
      </div>

      <div
        If="opened AND onChange AND !disabled"
        dropdown="-> opened=false"
        class="bg-base-200 relative z-10"
        style="min-width: 30rem; width: max-content">
        <CalendarPicker
          value=""
          onChange="-> newValue = event.value"
          close="-> opened=false"
        >
          <div class="flex-1">+ {caption}</div>
        </CalendarPicker>
      </div>
    </div>
  </FieldItem>
</Component>
