<Component id="Field.Json">
  <Signature purpose="Form field showing a JSON value as a tree" group="JsonView"
    description="Read-only field that wraps JsonView in the standard FieldItem frame, so a JSON value gets the same caption, helper and error layout as every other field. Use it inside a Forma for object or raw-payload values.">
    <Prop id="value" type="object" description="JSON value to render" />
    <Prop id="caption" type="string" description="Field label" />
    <Prop id="helper" type="string" description="Hint shown under the field" />
    <Prop id="error" type="string" description="Validation message shown instead of the helper" />
    <Prop id="required" type="boolean" description="Marks the field as required" />
    <Prop id="disabled" type="boolean" description="Renders the field in its muted, inactive state" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" helper="{helper}"
    disabled="{disabled}"
    value="{value}">
    <div class="">
      <JsonView data="{value}" class="" />
    </div>
  </FieldItem>
</Component>
