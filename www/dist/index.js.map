<Component id="JsonAnyView">
  <Signature purpose="Recursive renderer for one JSON value" group="JsonView"
    description="Renders any JSON value — object, array, string or primitive — with nested levels indented and foldable, and a short OBJECT or ARRAY marker while folded. Internal to JsonView; reach for JsonView unless you are rendering a single sub-value.">
    <Prop id="data" type="any" description="The JSON value to render" />
    <Prop id="level" type="number"
      description="Nesting depth; children past level 2 start folded" />
    <Prop id="collapsed" type="boolean" description="Folded state supplied by the parent" />
    <Prop id="collapse" type="action" description="Fires when the folded marker is clicked" />
  </Signature>
  <Selector On="{data|typeOf}{isValuable(data) ? '' : '-empty' }">
    <Case When="object">
      <span class="text-orange-100">{</span>
      <div class="ml-4 {collapsed ? 'hidden'}">
        <JsonAttrAndValue item="{item}" Each="item of data|mapEntries" collapse="{level > 2}"
          level="{level}" />
        <div class="-ml-4 text-orange-100">}</div>
      </div>
      <span class="text-orange-100 {!collapsed ? 'hidden'} cursor-pointer" click="{collapse}">
        OBJECT}</span>
    </Case>
    <Case When="object-empty">
      <span class="text-red-200">{}</span>
    </Case>
    <Case When="array-empty">
      <span class="text-red-200">[]</span>
    </Case>
    <Case When="array">
      <span class="text-orange-100">[</span>
      <div class="ml-4 {collapsed ? 'hidden'}">
        <JsonAnyView Each="item of narrowItemList(data)" data="{item}" level="{level|increment}" />
        <div class="text-orange-100 -ml-4">]</div>
      </div>
      <span class="text-orange-100 {!collapsed ? 'hidden'} cursor-pointer" click="{collapse}">
        ARRAY {data.length}]</span>
    </Case>
    <Case When="nullable-empty">
      <span class="text-red-200">[EMPTY]</span>
    </Case>
    <Case When="string-empty">
      <span class="text-red-200">"--"</span>
    </Case>
    <Case When="string">
      <span class="text-orange-200">"</span>
      <span
        class="text-orange-100 cursor-pointer text-wrap word-wrap  overflow-hidden max-w-full truncate ellipsis">
        {data}</span>
      <span class="text-orange-200">"</span>
    </Case>
    <Case When="default">
      <span class="text-orange-100">{data ?? '⚪'}</span>
    </Case>
  </Selector>

</Component>
