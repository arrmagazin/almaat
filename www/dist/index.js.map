<Component id="AsyncLoader">
  <Signature purpose="Async state wrapper: spinner, error stub, or content"
    description="Wraps content that depends on an async load. Shows a spinner stub while loading, an error stub with an optional retry button when the load fails, and the slotted content otherwise. Use it around any page or panel fed by a remote query."
    group="Feedback">
    <Prop id="isLoading" type="boolean" description="Renders the loading stub while true" />
    <Prop id="error" type="string" description="Error message; any truthy value switches the component to the error state" />
    <Prop id="title" type="string" description="Headline of the loading stub" />
    <Prop id="subtitle" type="string" description="Secondary line of the loading stub" />
    <Prop id="errorTitle" type="string" default="Error" description="Headline of the error stub" />
    <Prop id="icon" type="string" default="download" description="Icon name shown on both stubs" />
    <Prop id="onError" type="action" description="Retry/continue action; the error stub shows a Continue button only when it is set" />
    <Slot name="default" description="Content rendered once loading finished without an error" />
  </Signature>
  <Fragment If="!error">
    <Then>
      <Fragment If="isLoading">
        <Then>
          <Container>
            <Stub class="h-100 mt-4" title="{title}" subtitle="{error ? '' : subtitle}"
              icon="{icon ?? 'download'}">
              <Loading title="{R.loading ?? 'Loading...'}" />
            </Stub>
          </Container>
        </Then>
        <Else>
          <Slot />
        </Else>
      </Fragment>
    </Then>
    <Else>
      <Container>
        <Stub class="h100 mt-4 text-error" title="{errorTitle??'Error'}" subtitle="{error}"
          icon="{icon ?? 'download'}">
          <Btn action="{onError}" title="Continue" If="onError" />
        </Stub>
      </Container>
    </Else>
  </Fragment>
</Component>