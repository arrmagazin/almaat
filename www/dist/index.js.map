<Component id="ErrorMessage">
  <Signature purpose="Dismissible error alert banner"
    description="Red error alert with X icon for displaying error messages. Accepts error object or string. Use for API errors, validation failures, or system error notifications. Includes optional dismiss button and action link."
    group="Feedback">
    <Prop id="error" type="any" required="true"
      description="Error object {message} or error string to display" />
    <Prop id="close" type="action" description="Dismiss handler; hides close button if not provided" />
    <Prop id="link" type="string" description="URL for 'open' action link (e.g., to error details)" />
    <Prop id="closeTitle" type="string" default="Close"
      description="Tooltip and accessible name of the X button — an icon-only button has no label without it" />
  </Signature>

  <div
    class="alert alert-error flex gap-2 p-2 shadow z-10 {class}"
    role="alert">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none"
      viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div class="text-sm font-normal flex-1 text-wrap truncate">
      <span>{error.message ?? error}</span>
      <a class="font-bold ml-2" href="{link}" If="link">open</a>
    </div>
    <div If="close">
      <button type="button" class="btn btn-circle btn-ghost btn-sm icon icon-x"
        title="{closeTitle ?? 'Close'}" aria-label="{closeTitle ?? 'Close'}" click="{close}" />
    </div>
  </div>
</Component>