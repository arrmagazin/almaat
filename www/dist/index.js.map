<Component id="MDList">
  <Signature purpose="Bulleted list of a markdown document"
    description="Emitted by the markdown renderer for an unordered list without task markers. Nested lists get the same component one depth level deeper."
    group="Markdown">
    <Prop id="depth" type="number" description="Nesting level; anything above 0 is indented" />
    <Prop id="class" type="string" description="Extra CSS classes for the list" />
    <Slot name="default" description="List items" />
  </Signature>
  <ul class="list-disc px-4 list-inside my-2 space-y-1 text-sm {class} {depth==0?'':'ml-4'}">
    <Slot />
  </ul>
</Component>
