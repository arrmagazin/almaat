<Component id="Section">
  <Signature purpose="Section layout"
    description="The Section layout container "
    group="Layout">
    <Prop id="reverse" type="boolean" description="Reverse item order" />
    <Slot name="default" description="Child elements to stack" />
  </Signature>
  <section aria-orientation="vertical"
    class="flex flex-col{reverse ? '-reverse':''} 
      justify-start items-stretch min-h-0
      {class}"
  >
    <Slot />
  </section>
</Component>