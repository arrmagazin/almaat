<Component id="XmlView">
  <Signature purpose="Formatted, foldable XML tree" group="XmlView"
    description="Pretty-prints a parsed XML tree in a bordered monospace panel with colored tags and foldable elements, accepting either a single root node or an array of them. Use it to inspect markup payloads and CML sources in the UI.">
    <Prop id="data" type="object"
      description="Parsed XML tree: one root node or an array of nodes; shows a placeholder when empty" />
    <Prop id="class" type="string"
      description="Extra classes on the panel, e.g. a height cap for long documents" />
  </Signature>
  <div class="bg-slate-700 rounded-lg border border-slate-600 p-3 font-mono text-sm {class}">
    <Selector On="{data ? (data.length ? 'is-array' : 'has-data') : 'empty'}">
      <Case When="has-data">
        <XmlNodeView node="{data}" level="1" />
      </Case>
      <Case When="is-array">
        <XmlNodeView node="{elt}" level="1" Each="elt of data" />
      </Case>
      <Case When="empty">
        <span class="text-gray-400 italic">No XML data</span>
      </Case>
    </Selector>
  </div>
</Component>
