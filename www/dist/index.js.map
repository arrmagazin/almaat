<Component id="MDCode">
  <Signature purpose="Fenced code block of a markdown document"
    description="Emitted by the markdown renderer for a fenced code block (``` … ```), as `MDCode.&lt;lang&gt;` so a language may override it. Children are the already highlighted tokens."
    group="Markdown">
    <Prop id="lang" type="string" description="Language tag of the fence, used as the `language-*` class" />
    <Slot name="default" description="Syntax-highlighted code tokens (MDCodeElt spans)" />
  </Signature>
  <pre class="bg-base-200/80 rounded-xs p-4 overflow-x-auto text-xs my-4 border border-base-200">
    <code class="language-{lang}">
      <Slot />
    </code>
  </pre>
</Component>
