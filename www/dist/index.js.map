<Component id="CalendarPicker">
  <Signature purpose="Inline year, month and day calendar grid for picking one date"
    description="Standalone calendar panel that drives a DateValueController. Reach for it when a date surface is needed outside the form field chrome, for example inside a custom dropdown."
    group="Fields">
    <Prop id="value" type="string" description="Current date, as the ISO-like text the calendar parses and highlights" />
    <Prop id="onChange" type="action" description="Called with the picked date whenever a year, month or day cell is clicked" />
    <Prop id="placeholder" type="string" default="yyyy-mm-dd" description="Placeholder of the manual date entry box" />
    <Prop id="close" type="action" description="Called to dismiss the panel; fired by the close button and after a day is picked" />
    <Slot name="default" description="Header content of the panel, placed left of the manual entry box and buttons" />
  </Signature>
  <DateValueController
    Ref="ctrl"
    value="{value}"
    onChange="{onChange}" />
  <div
    class="p-2 border flex flex-col gap-2"
    style="min-width: 30rem; width: max-content">
    <div class="flex gap-2 mb-2 pb-2 items-center">
      <div class="flex-1">
        <Slot />
      </div>
      <div class="w-40">
        <input type="text"
          class="input"
          placeholder="{placeholder ?? 'yyyy-mm-dd'}"
          value="{@ctrl.value}"
          change="-> @ctrl.value = event.value" />
      </div>
      <IBtn size="sm" icon="clipboard"
        disabled="{!truthy(@ctrl.value)}"
        click="-> @browser.copyToClipboard(@ctrl.value)"
      />
      <Btn title="CLEAR" size="sm" mode="ghost" disabled="{!truthy(@ctrl.value)}"
        action="-> @ctrl.value=''" afterAction="{close}" />
      <Btn title="TODAY" size="sm" mode="primary" action="-> @ctrl.value='now'"
        afterAction="{close}" />
      <IBtn icon="x" size="sm" click="{close}" />
    </div>
    <div class="grid grid-cols-7 gap-2 text-center text-sm">
      <div class="grid grid-cols-1 gap-1">
        <div class="btn"
          click="-> @ctrl.decade = @ctrl.decade - 10">
          up
        </div>
        <div class="btn btn-sm {year.isSelected ? 'btn-accent':''}"
          click="-> @ctrl.year = year.id"
          Each="year of @ctrl.years">
          {year.id}
        </div>
        <div class="btn"
          click="-> @ctrl.decade = @ctrl.decade + 10">
          down
        </div>
      </div>
      <div class="grid grid-cols-1 gap-1">
        <div class="btn btn-sm {month.isSelected ? 'btn-accent':''}"
          click="-> @ctrl.month = month.id"
          Each="month of @ctrl.monthes">
          {month.name}
        </div>
      </div>
      <div class="grid grid-cols-7 col-span-5 gap-2">
        <div
          class="border-b border-t
              {dow.id==0 OR dow.id==6 ?'border-b-red-500' } 
              {dow.isSelected ?'border-t-blue-500' } 
              flex items-center justify-center"
          Each="dow of @ctrl.daysOfWeekNames">
          {dow.name}
        </div>

        <div style="grid-column: span {@ctrl.dayOfMonthShift}" If="@ctrl.dayOfMonthShift">
        </div>

        <div
          class="btn btn-sm {day.isSelected ? 'btn-accent':''}"
          click="-> @ctrl.date = day.id"
          afterClick="{close}"
          Each="day of @ctrl.monthDays">
          {day.name}
        </div>
      </div>
    </div>
  </div>
</Component>