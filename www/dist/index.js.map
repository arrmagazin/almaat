<Component id="Divider">
  <Signature purpose="Visual separator line with optional text"
    description="Horizontal or vertical dividing line to separate content sections. Can include centered text label like 'OR' or 'Section'. Use between form sections, list groups, or content blocks."
    group="Layout">
    <Prop id="text" type="string" description="Optional centered text label (e.g., 'OR', 'Section 2')" />
    <Prop id="horizontal" type="boolean" description="Vertical orientation when true (for side-by-side layouts)" />
  </Signature>
  <div class="divider {!horizontal ? '' :'divider-horizontal'} {class}">
    <span If="text">{text}</span>
  </div>
</Component>