<Component id="ThemeSelector">
  <Signature description="UI Theme Selector" group="Inputs">
  </Signature>

  <Subcomponent id="Item">
    <button
      class="btn justify-start btn-block {currentId == id ? 'btn-accent' : 'btn-ghost'}"
      click="-> @themeService.theme = id">
      <div data-theme="{id}"
        class="bg-base-100 grid shrink-0 grid-cols-2 gap-0.5 rounded-md p-1 shadow-sm">
        <div class="bg-base-content size-1 rounded-full"></div>
        <div class="bg-primary size-1 rounded-full"></div>
        <div class="bg-secondary size-1 rounded-full"></div>
        <div class="bg-accent size-1 rounded-full"></div>
      </div>
      <div class="w-32 truncate">{id}</div>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
        fill="currentColor" class="h-3 w-3 shrink-0" If="id == currentId">
        <path d="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z"></path>
      </svg>
    </button>
  </Subcomponent>

  <div title="Change Theme" class="block ">
    <button click="-> opened=true"
      role="button"
      class="btn group btn-circle {opened ? 'rounded-br-none' :'btn-ghost'}"
      aria-label="Change Theme">
      <div
        class="bg-base-100 group-hover:border-base-content/20 border-base-content/10 grid shrink-0 grid-cols-2 gap-0.5 rounded-md border p-1 transition-colors">
        <div class="bg-base-content size-2 rounded-full"></div>
        <div class="bg-primary size-2 rounded-full"></div>
        <div class="bg-secondary size-2 rounded-full"></div>
        <div class="bg-accent size-2 rounded-full"></div>
      </div>
    </button>

    <div If="opened"
      dropdown="-> opened=false"
      class="bg-base-200 text-base-content rounded-box h-122
       overflow-y-auto border border shadow-2xl z-50 px-2">
      <div class="flex gap-1">
        <div class="w-48" skip="cyberpunk,valentine,cupcake">
          <This-Item
            Each="theme of narrowItemList('light,bumblebee,emerald,corporate,retro,garden,lofi,pastel,fantasy,wireframe,cmyk,autumn,acid,lemonade,winter,nord,caramellatte,silk')"
            id="{theme.id}" currentId="{@themeService.theme}" />
        </div>
        <div class="divider divider-horizontal min-h-fit"></div>
        <div class="w-48">
          <This-Item
            Each="theme of narrowItemList('dark,synthwave,halloween,forest,aqua,black,luxury,dracula,business,night,coffee,dim,sunset,abyss')"
            id="{theme.id}" currentId="{@themeService.theme}" />
        </div>
      </div>
    </div>
  </div>
</Component>