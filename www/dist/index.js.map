<Component id="DbLoadingIndicator">
  <Signature purpose="Refresh button showing database operation state"
    description="Circular refresh button that spins while a database operation runs and turns red with the message as its tooltip when it fails. Use it in a toolbar to expose the state of a store query and let the user re-run it."
    group="Feedback">
    <Prop id="isLoading" type="boolean" description="Spins the icon and marks the button as busy" />
    <Prop id="error" type="string" description="Error message; shown as the tooltip and paints the button in the error color" />
    <Prop id="action" type="action" description="Click handler, normally a reload of the query" />
    <Prop id="data" type="object" description="Payload passed to the click handler" />
  </Signature>
  <button aria-selected="{isLoading}"
    class="btn btn-circle text-lg icon icon-refresh-cw
        {error ? 'btn-error' : 'btn-ghost'}
        {isLoading ? 'animate-spin btn-warning' : ''}
        "
    title="{error ?? 'OK'}" data="{data}" click="{action}">
    <span class="sr-only">{error ? 'ERR' : 'OK'}</span>
  </button>
</Component>