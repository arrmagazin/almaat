<Component id="Popover">
  <Signature purpose="Click-triggered floating content panel"
    description="Wraps trigger element with click-to-toggle floating panel. Automatically closes on outside click. Use for menus, tooltips with rich content, or contextual information panels."
    group="Layout">
    <Prop id="opened" type="boolean" description="Control open state externally (internal state by default)" />
    <Prop id="popoverClass" type="string" description="CSS classes for the floating panel" />
    <Slot name="default" description="Trigger element (clickable to toggle)" />
    <Slot name="popover" description="Floating panel content" />
  </Signature>
  <div class="cursor-pointer {class}" click="-> opened = !opened">
    <Slot />
    <div dropdown="-> opened=false"
      If="opened"
      class="bg-base-100 relative flex flex-col items-stretch rounded-sm shadow-lg z-50 p-1 {popoverClass}"
      style="min-width: 15rem; width: max-content;">
      <Slot Key="popover" />
    </div>
  </div>
</Component>