<Component id="DropdownOptionsList">
  <Signature purpose="Scrollable options panel for dropdown menus"
    description="Internal component rendering the options list panel for Dropdown. Supports single and multi-select modes with scrollable content area. Typically used internally by Dropdown but can be standalone for custom dropdown implementations."
    group="Inputs">
    <Prop id="options" type="array" required="true"
      description="Array of {id, name, symbol?, disabled?, isErroneous?} objects" />
    <Prop id="value" type="any" description="Selected option ID (single-select mode)" />
    <Prop id="values" type="array" description="Selected option IDs (multi-select mode)" />
    <Prop id="itemClick" type="action" description="Handler for single-select item clicks" />
    <Prop id="multiItemClick" type="action" description="Handler for multi-select checkbox clicks" />
    <Prop id="close" type="action" required="true" description="Handler to close the dropdown panel" />
    <Prop id="caption" type="string" description="Panel header title" />
    <Prop id="closeTitle" type="string" default="Close"
      description="Tooltip and accessible name of the X button — an icon-only button has no label without it" />
    <Prop id="data" type="any" description="Data payload passed to click handlers" />
    <Slot name="default" description="Custom content above options list" />
    <Slot name="btn" description="Action buttons in header row" />
  </Signature>

  <Subcomponent id="Item">
    <button
      class="btn justify-start text-start rounded-xs
        {isSelected ? 'btn-accent' : 'btn-ghost' }
        {isErroneous ? 'btn-error'}"
      disabled="{option.disabled}"
      style="padding-inline:0.5rem;font-weight: 400;">
      <input type="checkbox"
        checked="{isSelected}"
        class="checkbox bg-base-100!" data="{data}" data-id="{id}"
        data-value="{option.id}"
        disabled="{option.disabled}"
        click="{!option.disabled ? multiItemClick}" If="multiItemClick" />
      <div class="flex-1 pr-2 py-1"
        data="{assign(0,data)}"
        data-value="{option.id}"
        data-name="{option.name}"
        disabled="{option.disabled}"
        click="{!option.disabled ? click}" afterClick="{close}">
        <span class="mr-2" If="option.symbol">{option.symbol}</span>
        <span class="truncate text-start">{option.name ?? option.id}</span>
      </div>
    </button>
  </Subcomponent>

  <div dropdown="{close}"
    class="bg-base-100 relative flex flex-col rounded-xs border shadow-lg z-50 p-1 {class}"
    style="min-width: 15rem; width: max-content;">
    <div class="flex items-center gap-1 pl-2 pr-1 py-1 border-b border-base-300" If="caption">
      <h3 class="divide-b font-bold flex-1 truncate">{caption}</h3>
      <Slot Key="btn" />
      <IBtn icon="x" size="sm" title="{closeTitle ?? 'Close'}" click="{close}" />
    </div>
    <Slot />
    <div class="rounded-sm! gap-px flex flex-col flex-1 px-1 my-2 w-full overflow-x-hidden"
      style="overflow-y: auto;max-height:16rem;min-height:2rem;min-width:3rem;list-style: none;">
      <This-Item
        data="{data}"
        option="{option}"
        click="{itemClick ?? multiItemClick}"
        multiItemClick="{multiItemClick}"
        close="{close}"
        isErroneous="{truthy(option.isErroneous)}"
        isSelected="{truthy(option.id == value || includes(values, option.id) || option.isSelected)}"
        Each="option of options" />
    </div>
  </div>
</Component>
