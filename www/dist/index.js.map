<Component id="Skeleton">
  <Signature purpose="Loading placeholder shaped like a document"
    description="Animated blocks standing in for a title, subheading and paragraphs while content loads. Stays invisible for the first 100ms, so a load that resolves quickly never flashes it. Use as the pre-render state of an article or document view; for a short inline wait use Loading instead."
    group="Feedback">
  </Signature>

  <!-- Hidden for the first 100ms so a fast load never flashes the placeholder. -->
  <div
    class="p-6 max-w-4xl mx-auto flex flex-col gap-4
    opacity-100 transition-opacity duration-0 delay-100 starting:opacity-0 {class}">
    <div class="skeleton h-10 w-2/3"></div>
    <div class="skeleton h-4 w-full"></div>
    <div class="skeleton h-4 w-11/12"></div>
    <div class="skeleton h-4 w-10/12"></div>
    <div class="skeleton h-6 w-1/3 mt-4"></div>
    <div class="skeleton h-4 w-full"></div>
    <div class="skeleton h-4 w-9/12"></div>
    <div class="skeleton h-4 w-11/12"></div>
  </div>
</Component>
