<Component id="Icon">
  <Signature purpose="Lucide icon display"
    description="Renders a Lucide icon by name. Use for visual indicators, decorative elements, or alongside text. Icon names follow Lucide naming convention (e.g., 'user', 'settings', 'arrow-right'). Lucide ships here as an icon FONT, so the glyph is sized by font-size."
    group="Media">
    <Prop id="icon" type="string" required="true" description="Lucide icon name (e.g., 'check', 'x', 'user', 'settings')" />
    <Prop id="size" type="string"
      description="Either a Tailwind text-size token ('sm', 'lg', '2xl' → class text-lg) or a plain number of pixels ('22' → inline font-size: 22px). Numbers are emitted as inline style because a concatenated class name like text-22 is not a real utility and gets purged." />
    <Prop id="title" type="string" description="Tooltip text on hover" />
  </Signature>
  <div class="{arrayJoin(arrayPrefixAll('text-', size > 0 ? null : size),' ')} {class}"
    style="{size > 0 ? 'font-size:' + size + 'px' : ''}"
    title="{title}">
    <div class="icon icon-{icon}"></div>
  </div>
</Component>
