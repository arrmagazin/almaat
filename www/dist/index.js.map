<Component id="XmlElement">
  <Signature purpose="Recursive renderer for one XML element" group="XmlView"
    description="Renders an opening tag with its attributes, then its children indented, folding to a children count when closed and to a self-closing or single-text form when the node has none. Internal to XmlView; render a whole document with XmlView.">
    <Prop id="node" type="object"
      description="Element node carrying tag, attrs, text and children or nodes" />
    <Prop id="level" type="number" description="Nesting depth, passed down to the children" />
    <Prop id="collapse" type="boolean"
      description="Folded state of this element; clicking its tag name toggles it" />
    <Prop id="collapsed" type="boolean" description="Folded state forced by the parent" />
  </Signature>
  <Selector On="{node|typeOf}{hasChildren(node,'nodes') ? '' : '-leaf'}">
    <!-- Element with children -->
    <Case When="object">
      <div>
        <!-- Opening tag -->
        <span class="text-blue-400">&lt;</span>
        <span class="text-pink-400 cursor-pointer" click="-> collapse=!collapse">{node.tag}</span>
        <XmlAttribute Each="attr of node.attrs|mapEntries" name="{attr.id}" value="{attr.value}" />
        <span class="text-blue-400">&gt;</span>

        <!-- Children (collapsible) -->
        <div class="ml-4 {collapsed || collapse ? 'hidden'}">
          <XmlNodeView Each="child of node.children??node.nodes" node="{child}"
            level="{level|increment}" />
        </div>

        <!-- Collapsed indicator -->
        <span class="{!collapsed AND !collapse ? 'hidden'} text-gray-500 cursor-pointer"
          click="-> collapse=!collapse">
          ...{(node.children??node.nodes).length} children...
        </span>

        <!-- Closing tag -->
        <span class="text-blue-400">&lt;/</span>
        <span class="text-pink-400">{node.tag}</span>
        <span class="text-blue-400">&gt;</span>
      </div>
    </Case>

    <!-- Self-closing element (no children) -->
    <Case When="object-leaf">
      <div>
        <span class="text-blue-400">&lt;</span>
        <span class="text-pink-400">{node.tag}</span>
        <XmlAttribute Each="attr of node.attrs|mapEntries" name="{attr.id}" value="{attr.value}" />
        <Selector On="{node.text ? 'has-text' : 'self-closing'}">
          <Case When="has-text">
            <span class="text-blue-400">&gt;</span>
            <span class="text-gray-100">{node.text}</span>
            <span class="text-blue-400">&lt;/</span>
            <span class="text-pink-400">{node.tag}</span>
            <span class="text-blue-400">&gt;</span>
          </Case>
          <Case When="self-closing">
            <span class="text-blue-400"> /&gt;</span>
          </Case>
        </Selector>
      </div>
    </Case>
  </Selector>
</Component>
