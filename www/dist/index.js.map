<Component id="Field.Dictionary">
  <Signature purpose="Typed lookup field backed by the local dictionary store"
    description="Opens a keyword search over the IndexedDB dictionary store and lets the user pick an existing entry or add a new one on the spot. Use for reference lists that grow over time and are not fixed enums."
    group="Fields">
    <Prop id="value" type="string" description="Selected dictionary entry name" />
    <Prop id="typeSpec" type="string" description="Dictionary type; scopes the store lookup key and is saved on entries added here" />
    <Prop id="onChange" type="action" description="Called with the picked or newly created name; when absent the field is read-only" />
    <Prop id="disabled" type="boolean" description="Keeps the dropdown closed and hides the toggle button" />
    <Prop id="limit" type="number" default="50" description="Page size of the dictionary query; grows by 50 as the result list is scrolled" />
    <Prop id="class" type="string" description="Extra classes for the closed control box" />
    <Prop id="caption" type="string" description="Field label, repeated as the dropdown heading" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}"
    required="{required}"
    disabled="{disabled}"
    hint="{hint}">
    <div class="relative flex-1 w-0">
      <div
        click="-> opened = onChange AND !disabled"
        class="border rounded-field bg-base-100 pl-1 pr-1 w-full! min-h-10 flex items-center
        {class}">
        <div title="{value}"
          class="group flex-1 py-1 truncate relative">
          <span class="pl-2 pr-10">{value||''}</span>
          <div class="absolute right-2 hidden group-hover:flex gap-1 bg-base-100">
            <button
              class="btn btn-circle btn-ghost btn-sm icon icon-clipboard"
              click="-> @browser.copyToClipboard(value)"
              If="value" />
          </div>
        </div>
        <button
          class="btn btn-circle btn-ghost btn-sm icon icon-{opened ? 'x' : 'list'}"
          If="onChange AND !disabled" />
      </div>

      <div If="opened AND !!onChange AND !disabled"
        dropdown="-> opened = false"
        class="bg-base-200 relative flex flex-col rounded-box shadow-lg z-10 items-stretch gap-1 p-2"
        style="min-width: 20rem; width: max-content">

        <IndexedDbQuery Ref="query"
          db="@db"
          store="dictionary"
          value="X{typeSpec}${lowerCase(kliuq ?? '')}*"
          limit="{limit ?? 50}" />

        <Connector
          data="{newValue | pack:'value' | fnBindTo : onChange}"
          trigger="{newValue}"
          If="newValue"
          change="-> addedCallback" />

        <Connector
          data="@query.data"
          change="-> options" />

        <Connector
          data-value="{value}"
          trigger="{value}"
          change="{onChange}" />

        <Connector
          data-name="{newValue}"
          data-id="X{typeSpec}${newValue}"
          data-store="dictionary"
          data-type="{typeSpec}"
          trigger="{newValue}"
          If="newValue AND newValue!=value "
          data-callback="{addedCallback}"
          change="-> @api.upsertObject()" />

        <Bar justify="between">
          <h2 class="flex-1 font-bold">{caption}</h2>
          <Btn size="sm" title="Clear" action="-> value=''; newValue=''; kliuq = ''; opened = false" />
          <IBtn icon="x" size="sm" click="-> opened = false" />
        </Bar>
        <Bar class="w-full relative">
          <input
            class="flex-1 min-h-10 border pl-2 pr-10
              bg-base-100 rounded-md focus:ring-transparent ring-transparent"
            type="text"
            autofocus="true"
            value="{kliuq}"
            placeholder="enter keyword..."
            keypress="-> kliuq = event.value" />
          <IBtn size="xs" icon="x" mode="ghost"
            class="absolute right-1"
            click="-> kliuq = ''"
          />
        </Bar>

        <div>
          <button class="btn btn-primary btn-block"
            If="!find(options, strTrim(kliuq), 'name') AND kliuq"
            click="-> newValue = strTrim(kliuq); opened=false">
            Add New "{strTrim(kliuq)}"
          </button>
        </div>

        <div If="kliuq"
          class=" w-full flex flex-col overflow-x-hidden"
          style="
            overflow-y: auto;
            max-height: 16rem;
            min-height: 2rem;
            min-width: 20rem;
            list-style: none;
          "
          scrolledDown="-> limit = limit ?? 50 | plus: 50">
          <button
            Each="option of options"
            class=" justify-start text-start btn {value == option.name?'btn-accent':'btn-ghost'} btn-block"
            click="-> value = option.name ?? ''; opened = false"
          >
            {option.name ?? '[...]'}
          </button>
        </div>
      </div>

    </div>
  </FieldItem>
</Component>