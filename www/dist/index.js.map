<Component id="TableCell.Enum">
  <Signature purpose="Enum cell of a Table row"
    description="Resolves the value against the `R.enums` set named by the column's typeSpec and shows it as a soft badge, or as a dropdown when the row supplies a change handler. A TableRow picks it for columns with type `enum`."
    group="Table">
    <Prop id="value" type="string" description="Enum id held by this column for the row" />
    <Prop id="typeSpec" type="string" description="Name of the `R.enums` set the value is resolved against" />
    <Prop id="data" type="object" description="The whole row record; its id is stamped on the dropdown as data-id" />
    <Prop id="id" type="string" description="Column id, stamped on the dropdown as data-field" />
    <Prop id="change" type="action" description="Table `cellChange` handler; when absent the cell stays read-only" />
    <Prop id="disabled" type="boolean" description="Keeps the cell read-only even when a change handler is given" />
  </Signature>
  <Connector data="{find(R.enums[typeSpec], value)}" change="-> item" />
  <Fragment If="change AND !disabled">
    <Then>
      <Dropdown
        options="{R.enums[typeSpec]}"
        value="{value}"
        data-id="{data.id}"
        data-field="{id}"
        change="-> change(it)"
        triggerClass="border-0 btn-block text-start rounded-none self-stretch {item.style}" />
    </Then>
    <Else>
      <!-- Soft badge INSIDE the cell, not a full-bleed fill: a saturated background
           stretched over the whole cell drowns the row. `item.style` still wins if a
           caller wants a bespoke look. -->
      <div class="flex items-center max-w-80 min-w-0 px-2 py-1">
        <span If="value"
          class="badge badge-sm badge-soft badge-{item.type} max-w-full {item.style}">
          <span If="item.symbol" class="w-4">{item.symbol}</span>
          <span class="truncate">{capitalize(item.name ?? value)}</span>
        </span>
      </div>
    </Else>
  </Fragment>
</Component>
