<Component id="Field.DatePeriod">
  <Signature purpose="Start and end date pair"
    description="Two native date inputs side by side; the end date lives in a sibling field. Use for validity ranges, bookings and assignments."
    group="Fields">
    <Prop id="value" type="string" description="Start date, bound to the first input" />
    <Prop id="typeSpec" type="string" description="Key of the sibling end-date field inside data" />
    <Prop id="data" type="object" description="Whole form record; the end date is read from it by the typeSpec key" />
    <Prop id="onChange" type="action" description="Called with the new start date" />
    <Prop id="disabled" type="boolean" description="Blocks the start date input" />
    <Prop id="placeholder" type="string" description="Placeholder of the start date input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}">
    <div class="grid grid-cols-2 gap-2">
      <input type="date" class="input" disabled="{disabled}"
        placeholder="{placeholder}"
        value="{value}"
        change="{onChange}" />
      <input type="date" class="input" style="min-width: 6rem;"
        disabled="{!value ?? disabled}"
        value="{data | dot:typeSpec}" change="{onChangeFor[typeSpec]}" />
    </div>
  </FieldItem>
</Component>
