<Component id="XmlTextNode">
  <Signature purpose="Text content between XML tags" group="XmlView"
    description="Renders a text node with its whitespace and line breaks preserved. Used by XmlNodeView for every string child.">
    <Prop id="text" type="string" description="Text content of the node" />
  </Signature>
  <span class="text-gray-100 whitespace-pre-wrap">{text}</span>
</Component>
