<Component id="MDBlockQuote">
  <Signature purpose="Renders a markdown blockquote (&gt; …)"
    description="Emitted by the markdown renderer for a `blockquote` token. Wraps the quoted block content in a left-ruled, muted container."
    group="Markdown">
    <Slot name="default" description="Block content of the quote (paragraphs, lists, nested quotes)" />
  </Signature>
  <blockquote class="border-l-4 border-base-300 pl-4 my-4 text-base-content/70">
    <Slot />
  </blockquote>
</Component>
