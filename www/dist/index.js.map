<Component id="MDImage">
  <Signature purpose="Image from markdown image syntax"
    description="Emitted by the markdown renderer for `![alt](src &quot;title&quot;)`. Relative sources are prefixed with R.app.imageSrcBase so a docs site can serve images from its own folder."
    group="Markdown">
    <Prop id="src" type="string" description="Image source from the markdown link target" />
    <Prop id="alt" type="string" description="Alt text from the square brackets" />
    <Prop id="title" type="string" description="Optional title from the quoted part of the link" />
  </Signature>
  <img class="block max-w-full h-auto my-4 rounded-box border border-base-300"
    src="{R.app.imageSrcBase||''}{src}"
    alt="{alt}"
    title="{title}"
    loading="lazy" />
</Component>
