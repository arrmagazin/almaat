<Component id="Field.Enum">
  <Signature purpose="Single-choice select over an enum"
    description="Dropdown over a named option list, taken from R.enums or supplied explicitly. Use for closed value sets with exactly one selection."
    group="Fields">
    <Prop id="value" type="string" description="Selected option id" />
    <Prop id="typeSpec" type="string" description="Key into R.enums naming the option list; used when options is not supplied" />
    <Prop id="options" type="array" description="Explicit option list, taking precedence over the typeSpec lookup" />
    <Prop id="defaultValue" type="string" description="Option id preselected while value is empty" />
    <Prop id="onChange" type="action" description="Called with the selected option id" />
    <Prop id="disabled" type="boolean" description="Blocks the select" />
    <Prop id="placeholder" type="string" description="Text of the empty option" />
    <Prop id="class" type="string" description="Extra classes for the field frame" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}"
    class="{class}"
    error="{error}"
    required="{required}"
    hint="{hint}"
    disabled="{disabled}">
    <Select change="{onChange}"
      class="w-full"
      value="{value ?? defaultValue ?? ''}"
      options="{options ?? R.enums[typeSpec]}"
      placeholder="{placeholder}"
      disabled="{disabled}" />
  </FieldItem>
</Component>