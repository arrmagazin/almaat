<Component id="SearchBarSuggestions">
  <Signature purpose="Search input with a suggestions dropdown"
    description="Rounded search field that opens a dropdown of matching items once the query is longer than two characters. Use it for type-ahead lookup where the caller owns the query text and recomputes the suggestion list."
    group="Inputs">
    <Prop id="value" type="string" description="Current query text" />
    <Prop id="placeholder" type="string" description="Input placeholder and tooltip; defaults to the search_by_keyword string" />
    <Prop id="input" type="action" description="Keypress handler receiving the typed query" />
    <Prop id="suggestions" type="array" description="Items to list in the dropdown: {id, name, count}" />
    <Prop id="enter" type="action" description="Handler fired when a suggestion is picked; the chosen id arrives as data-value" />
    <Slot name="default" description="Extra content pinned to the top of the suggestions dropdown" />
  </Signature>

  <div class="relative"
    title="{placeholder ?? R.strings.search_by_keyword}">

    <Bar class="relative w-max" click="-> opened=true">
      <input class="input rounded-full! sm:w-48 w-24 flex-auto h-10 pr-8"
        type="text"
        autofocus="true"
        placeholder="{placeholder ?? R.strings.search_by_keyword}"
        keypress="{input}"
        value="{value}"
        focus="-> opened=true" />
      <!-- decorative adornment: no handler, so keep it out of the tab order and the a11y tree -->
      <button type="button" tabindex="-1" aria-hidden="true"
        class="btn btn-circle btn-ghost absolute right-1 btn-sm icon icon-search" />
    </Bar>

    <div class="relative">
      <ul dropdown="-> opened=false" If="opened AND value.length > 2"
        class="bg-base-100 relative flex flex-col rounded-md shadow-lg z-50 p-1"
        style="min-width: 16rem; max-width: 24rem; max-height:16rem; overflow-y:auto; z-index:101;"
        click="-> opened=false">
        <li class="flex gap-2 no-wrap justify-between items-center px-2 pb-2">
          <Slot />
        </li>
        <li Each="item of suggestions"
          class="justify-start btn btn-ghost btn-block"
          data-value="{item.id}"
          click="{enter}">
          <div class="flex-1 text-start no-wrap truncate ellipsis">{item.name}</div>
          <div class="badge badge-soft badge-info" If="item.count">
            {item.count}</div>
        </li>
      </ul>
    </div>

  </div>
</Component>