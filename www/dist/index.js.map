<Component id="TableCell.Boolean">
  <Signature purpose="Boolean cell of a Table row"
    description="Renders a flag as an editable checkbox when the row supplies a change handler, and as a check mark otherwise. A TableRow picks it for columns with type `boolean`."
    group="Table">
    <Prop id="value" type="boolean" description="Flag value of this column for the row" />
    <Prop id="data" type="object" description="The whole row record; its id is stamped on the checkbox as data-id" />
    <Prop id="id" type="string" description="Column id, stamped on the checkbox as data-field" />
    <Prop id="change" type="action" description="Table `cellChange` handler; when absent the cell stays read-only" />
    <Prop id="disabled" type="boolean" description="Keeps the cell read-only even when a change handler is given" />
  </Signature>
  <Fragment If="change AND !disabled">
    <Then>
      <input type="checkbox"
        class="checkbox checkbox-sm"
        checked="{!!value}"
        data-id="{data.id}"
        data-field="{id}"
        toggle="{change}" />
    </Then>
    <Else>
      <span class="px-2 py-1 flex items-center justify-center">{value ?'✅':''}</span>
    </Else>
  </Fragment>
</Component>
