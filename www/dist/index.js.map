<Component id="MDCheckbox">
  <Signature purpose="Checkbox marker of a markdown task-list item"
    description="Emitted by the markdown renderer for a GFM task item (`- [ ]` / `- [x]`). Read-only by default; docs sites override it to make the box clickable."
    group="Markdown">
    <Prop id="checked" type="boolean" description="Checked state taken from the task item marker" />
    <Prop id="class" type="string" description="Extra CSS classes for the input" />
  </Signature>
  <input type="checkbox"
    class="mr-2 align-middle {class}"
    checked="{checked}" />
</Component>
