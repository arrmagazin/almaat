<Component id="XmlAttribute">
  <Signature purpose="One name and value pair inside an XML tag" group="XmlView"
    description="Renders a single attribute with the name, the equals sign and the quoted value each colored separately. Used by XmlElement for every entry of a node's attribute map.">
    <Prop id="name" type="string" description="Attribute name" />
    <Prop id="value" type="string" description="Attribute value, rendered inside quotes" />
  </Signature>
  <span class="ml-1">
    <span class="text-yellow-300">{name}</span>
    <span class="text-gray-400">=</span>
    <span class="text-green-300">"{value}"</span>
  </span>
</Component>
