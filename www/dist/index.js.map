<Component id="Field">
  <Signature purpose="Generic single-line input field"
    description="The base text field behind Field.Number, Field.Password and other simple inputs, with hover-revealed clear and copy buttons. Use it directly for plain text values."
    group="Fields">
    <Prop id="id" type="string" description="Field id; becomes the input name" />
    <Prop id="value" type="string" description="Current text" />
    <Prop id="inputType" type="string" description="Native input type, for example text, number or password" />
    <Prop id="onChange" type="action" description="Called with the new value; also drives the clear button" />
    <Prop id="change" type="action" description="Fallback change handler used when onChange is not supplied" />
    <Prop id="onKeypress" type="action" description="Called on every keystroke" />
    <Prop id="keypress" type="action" description="Fallback keystroke handler used when onKeypress is not supplied" />
    <Prop id="disabled" type="boolean" description="Blocks editing and hides the clear button" />
    <Prop id="placeholder" type="string" description="Placeholder of the input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="helper" type="string" description="Prefix content of the field frame; the input drops its left rounding for it" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" helper="{helper}"
    disabled="{disabled}" hint="{hint}"
    value="{value}">
    <div class="group flex-1 flex items-center relative">

      <input name="{id}" type="{inputType}"
        class="input validator w-full! {error ? 'border-red-600'} {helper ? 'rounded-l-none'}"
        placeholder="{placeholder}"
        value="{value}"
        required="{required}"
        change="{onChange??change}"
        keypress="{onKeypress??keypress}"
        disabled="{disabled}" />
      <div
        class="absolute top-1 right-[0.75rem] hidden bg-base-100 rounded-full group-hover:block"
        If="value">
        <button
          class="btn btn-circle btn-ghost btn-sm icon icon-x"
          data-value=""
          If="(onChange??change) AND !disabled"
          click="{onChange??change}"
        />
        <button
          class="btn btn-circle btn-ghost btn-sm icon icon-clipboard"
          click="-> @browser.copyToClipboard(value)"
        />
      </div>
    </div>
  </FieldItem>
</Component>
