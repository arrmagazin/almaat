<Component id="IText">
  <Signature purpose="Icon with text inline"
    description="Horizontal inline element combining icon and text. Icon appears before text with automatic spacing. Use for labeled icons, status indicators with text, or menu items."
    group="Typography">
    <Prop id="text" type="string" description="Text to display after icon" />
    <Prop id="icon" type="string" description="Lucide icon name" />
    <Prop id="iconClass" type="string" description="Additional CSS classes for the icon" />
  </Signature>
  <div
    class="inline-flex items-center {class}">
    <div class="icon icon-{icon} {iconClass}" If="icon"></div>
    <span class="{icon ? 'ml-1' :''}" If="text">{text}</span>
  </div>
</Component>
