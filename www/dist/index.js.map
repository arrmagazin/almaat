<Component id="MDMermaid">
  <Signature purpose="Mermaid diagram rendered from a ```mermaid fence"
    description="Emitted by the markdown renderer instead of MDCode when a fenced block is tagged `mermaid`. Renders the diagram asynchronously, showing a spinner while it draws and an error panel if the source does not parse."
    group="Markdown">
    <Prop id="diagramId" type="string" description="Unique element id for this diagram; must differ per diagram on a page" />
    <Prop id="plain" type="string" description="Mermaid source text of the fenced block" />
    <Prop id="class" type="string" description="Extra CSS classes for the diagram frame" />
  </Signature>
  <pre Ref="mermaidElt" id="{diagramId}"
    class="w-full my-3 border border-base-300/80 bg-base-200/80 rounded-sm p-2 md:p-4 {class}"
    click="-> counter = event.nativeEvent.target.textContent"></pre>
  <MarkdownMermaidService Ref="mermaidService" elt="@mermaidElt" eltId="{diagramId}"
    plain="{plain}" />
  <div class="flex items-center gap-2 my-2 text-xs text-base-content/60" If="!@mermaidService.done">
    <span class="loading loading-spinner loading-xs"></span>
    <span>Rendering diagram...</span>
  </div>
  <div class="my-2 p-2 rounded-sm border border-error/40 bg-error/10 text-error text-xs"
    If="@mermaidService.error">
    <div class="font-semibold">Diagram failed to render</div>
    <pre class="whitespace-pre-wrap">{@mermaidService.error}</pre>
  </div>
</Component>
