<Component id="JsonView">
  <Signature purpose="Formatted, foldable JSON tree" group="JsonView"
    description="Pretty-prints a JSON value in a bordered panel with colored syntax and foldable objects and arrays. Use it to inspect API payloads, stored documents or any raw object in the UI.">
    <Prop id="data" type="any" description="JSON value to render" default="--" />
    <Prop id="class" type="string" description="Extra classes on the panel, e.g. a height cap for long payloads" />
  </Signature>
  <div class="bg-slate-600 rounded-lg border p-2 {class}">
    <JsonAnyView data="{data ?? '--'}" level="1" />
  </div>
</Component>
