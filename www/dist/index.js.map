<Component id="Field.DateAndWorkingHours">
  <Signature purpose="Date input paired with a working-hours select"
    description="A native date picker plus a dropdown of working-hour slots kept in a sibling field. Use for scheduling inside fixed office hours."
    group="Fields">
    <Prop id="value" type="string" description="Date part, bound to the native date input" />
    <Prop id="typeSpec" type="string" description="Key of the sibling working-hours field inside data" />
    <Prop id="data" type="object" description="Whole form record; the selected slot is read from it by the typeSpec key" />
    <Prop id="onChange" type="action" description="Called with the new date" />
    <Prop id="disabled" type="boolean" description="Blocks both the date input and the hours select" />
    <Prop id="placeholder" type="string" description="Placeholder of the date input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}">
    <div class="flex">
      <input class="input" type="date" disabled="{disabled}" placeholder="{placeholder}"
        value="{value}"
        change="{onChange}" />
      <Select class="form-select ml-2" disabled="{disabled}"
        change="{onChangeFor[typeSpec]}"
        placeholder="-" value="{data | dot:typeSpec}" options="{R.enums.workingHours}" />
    </div>
  </FieldItem>
</Component>
