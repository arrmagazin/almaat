<Component id="Card">
  <Signature purpose="to show card item"
    description="Renders card layout element."
    group="Layout">
    <Prop id="title" type="string" description="heading text" />
    <Slot name="default" />
  </Signature>

  <View class="card bg-base-100 shadow {class}">
    <View class="card-body">
      <Text class="card-title" text="{title}" If="title" />
      <Slot />
    </View>
  </View>
</Component>