<Component id="Avatar">
  <Signature purpose="User profile image or initials placeholder"
    description="Displays user avatar with image, initials fallback, or default user icon. Supports online/offline status indicator and notification badge. Use in headers, user lists, comments, or profile sections."
    group="Media">
    <Prop id="src" type="string" description="Image URL for avatar photo" />
    <Prop id="alt" type="string" description="Alt text for accessibility (user name)" />
    <Prop id="initials" type="string"
      description="1-2 letter initials when no image (e.g., 'JD' for John Doe)" />
    <Prop id="size" type="enum" enum="xs,sm,md,lg,xl" default="10"
      description="Avatar diameter in Tailwind units" />
    <Prop id="status" type="string"
      description="Status indicator class — use a semantic token (e.g., 'bg-success' for online, 'bg-base-300' for offline)" />
    <Prop id="statusSymbol" type="string"
      description="Badge symbol overlay (e.g., notification count)" />
    <Prop id="click" type="action" description="Click handler for interactive avatars" />
  </Signature>
  <figure
    class="relative avatar {initials?'avatar-placeholder':''} rounded-full {class}
    flex-row items-center justify-center"
    style="width: calc(var(--spacing) * {size ?? 10}); height: calc(var(--spacing) * {size ?? 10})"
    click="{click}">
    <span If="!src"
      class="flex relative justify-center items-center rounded-full"
      style="width: calc(var(--spacing) * {size ?? 10}); height: calc(var(--spacing) * {size ?? 10})">
      <span class="font-medium uppercase" title="{alt}" If="initials">{initials}</span>
      <Icon icon="user" If="!initials" title="{alt}" />
    </span>

    <img class="rounded-full"
      style="width: calc(var(--spacing) * {size ?? 10}); height: calc(var(--spacing) * {size ?? 10})"
      src="{src}"
      alt="{alt}"
      If="src" />

    <span
      class="bottom-0 left-7 absolute 
        w-4 h-4 rounded-full text-xs
        {status} 
        border-2 border-base-100"
      If="status"></span>

    <span class="-top-1 -left-1 text-sm absolute badge badge-secondary badge-soft w-4 h-4"
      If="statusSymbol">
      {statusSymbol}</span>

  </figure>
</Component>