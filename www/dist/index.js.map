<Component id="Bar">
  <Signature purpose="Horizontal flex container for inline layouts"
    description="Horizontal flexbox row with configurable alignment and spacing. Use for toolbars, button groups, navigation bars, or any horizontal arrangement of elements. Default gap-2 spacing."
    group="Layout">
    <Prop id="justify" type="enum" enum="start,center,end,between,around,evenly" default="start"
      description="Horizontal distribution (justify-content)" />
    <Prop id="align" type="enum" enum="start,center,end,stretch,baseline" default="center"
      description="Vertical alignment (align-items)" />
    <Prop id="wrap" type="boolean" description="Allow items to wrap to next line" />
    <Prop id="click" type="action" description="Click handler for the container" />
    <Prop id="data" type="any" description="Data payload for click events" />
    <Prop id="style" type="string" description="Inline CSS styles" />
    <Slot name="default" description="Child elements to arrange horizontally" />
  </Signature>
  <div aria-orientation="horizontal"
    class="flex flex-row
      justify-{justify ?? 'start'} 
      items-{align ?? 'center'} 
      {wrap ? 'flex-wrap' : ''} 
      {includes(class,'gap-') ? '' : 'gap-2'}
      {class}"
    style="{style}"
    click="{click}"
    data="{data}"
  >
    <Slot />
  </div>
</Component>