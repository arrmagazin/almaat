<Component id="DocsSidebar">
  <Signature purpose="Collapsible docs navigation sidebar — wraps DocsTree with toggle control"
    group="Books">
  </Signature>

  <aside
    class="top-0 left-0 z-20 flex flex-col bg-base-200 border-base-300 transition-all duration-200 overflow-hidden
    {@localStorage.collapsed ? 'relative w-full h-auto border-b md:w-10 md:h-full md:border-b-0 md:border-r' : 'absolute md:relative w-64 min-w-64 h-full border-r'}">
    <div
      class="flex items-center px-2 py-2 border-b border-base-300 justify-between {@localStorage.collapsed ? 'md:justify-center' : ''}">
      <a href="/#/">
        <Bar
          class="text-xs font-semibold text-base-content/40 uppercase tracking-wider px-1
        {@localStorage.collapsed ? 'md:hidden' : ''}">
          <img class="w-6 h-6" If="{R.app.logo}" src="{R.app.logo}" />
          <span>{params.name|capitalize}</span>
        </Bar>
      </a>
      <IBtn
        icon="{@localStorage.collapsed ? 'panel-left-open' : 'panel-left-close'}"
        size="sm"
        click="-> @localStorage.collapsed = !@localStorage.collapsed" />
    </div>
    <div class="flex-1 overflow-y-auto py-2 px-1">
      <DocsTree data="{@docs.index}" If="{!@localStorage.collapsed}">
        <Else>
          <a href="/#/" If="{R.app.logo}">
            <img class="mx-auto w-4 h-4" src="{R.app.logo}" />
          </a>
        </Else>
      </DocsTree>
    </div>
  </aside>

</Component>