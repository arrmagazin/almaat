<Component id="View">
  <Signature purpose="Vertical flex container for stacked layouts"
    description="Vertical flexbox column (default) or row with configurable alignment. Use for page sections, card content, form layouts, or any vertical/horizontal stacking of elements. Default gap-2 spacing."
    group="Layout">
    <Prop id="dir" type="enum" enum="col,row" default="col"
      description="Flex direction ('row' for horizontal)" />
    <Prop id="justify" type="enum" enum="start,center,end,between,around,evenly" default="start"
      description="Main axis distribution" />
    <Prop id="align" type="enum" enum="start,center,end,stretch,baseline"
      description="Cross axis alignment (default: stretch for col, center for row)" />
    <Prop id="reverse" type="boolean" description="Reverse item order" />
    <Prop id="click" type="action" description="Click handler for the container" />
    <Prop id="data" type="any" description="Data payload for click handler" />
    <Prop id="style" type="string" description="Additional inline CSS styles" />
    <Slot name="default" description="Child elements to stack" />
  </Signature>
  <div aria-orientation="vertical"
    class="flex flex-{dir=='row' ? 'row' : 'col'}{reverse ? '-reverse':''} 
      justify-{justify ?? 'start'} 
      items-{align ?? (dir=='row' ? 'center': 'stretch')} 
      {includes(class,'gap-') ? '' : 'gap-2'}
      {class}"
    style="{style}"
    click="{click}"
    data="{data}"
  >
    <Slot />
  </div>
</Component>