<Component id="Field.File">
  <Signature purpose="File upload field with an attachment list"
    description="A file input that uploads through the api service and lists every attachment with its status and type. Use for documents and images hanging off a record."
    group="Fields">
    <Prop id="id" type="string" description="Field id; tells the controller which record field holds the attachments" />
    <Prop id="value" type="array" description="Current attachment list handed to the file controller" />
    <Prop id="data" type="object" description="Whole form record; its id, name and ts identify the owning item and retrigger the upload" />
    <Prop id="onChange" type="action" description="Called with the updated attachment list" />
    <Prop id="disabled" type="boolean" description="Blocks picking a file" />
    <Prop id="name" type="string" description="Name attribute of the file input" />
    <Prop id="class" type="string" description="Extra classes for the file input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldFileController Ref="ctrl" value="{value}"
    itemId="{data.id}-{data.name??''}"
    trigger="{data.id}-{data.ts??''}"
    field="{id}"
    change="{onChange}"
    uploadFile="-> @api.uploadFile()" />

  <FieldItem caption="{caption}" error="{error}" required="{required}"
    hint="{hint}">
    <div class="w-full flex-1 flex flex-col">
      <input
        name="{name}"
        type="file"
        class=" w-full input px-2 py-1 rounded-lg {class}"
        placeholder="placeholder ?? ''"
        change="-> @ctrl.appendFile()"
        disabled="{disabled}"
        multiple="false" />
      <div class="w-full flex-1 grid grid-cols-[1fr_5rem_7rem]">
        <Fragment Each="file of @ctrl.files">
          <a class="p-2 underline" target="_{file.id}" href="{file.url}" If="!file.fullPath"
          >
            <span>{file.name}</span>
            <Else>
              <a class="p-2 underline cursor-pointer"
                target="_{file.id}"
                click="-> @api.openFile(file.fullPath)"
              >
                {file.name}</a>
            </Else>
          </a>
          <span>{file.status??'saved'}</span>
          <span>{file.type}</span>
        </Fragment>
      </div>
    </div>
  </FieldItem>
</Component>