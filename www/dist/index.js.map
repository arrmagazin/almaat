<Component id="Field.Boolean">
  <Signature purpose="Checkbox form field for a yes/no value"
    description="Renders a labelled checkbox with an optional hint popover. Use for flags such as active, archived or opt-in."
    group="Fields">
    <Prop id="id" type="string" description="Field id; becomes the checkbox element id" />
    <Prop id="value" type="boolean" description="Current checked state" />
    <Prop id="caption" type="string" description="Label rendered to the right of the checkbox" />
    <Prop id="disabled" type="boolean" description="Blocks toggling" />
    <Prop id="error" type="string" description="When set, the checkbox is tinted with the error colour" />
    <Prop id="onChange" type="action" description="Called with the new checked state" />
    <Prop id="hint" type="string" description="Help text shown in an info popover next to the checkbox" />
  </Signature>
  <Bar>
    <Checkbox id="{id}" value="{value}" title="{caption}" disabled="{disabled}"
      class="text-sm {error ? 'checkbox-error' : ''}" change="{onChange}" />
    <Popover icon="info" popoverClass="border" If="hint">
      <div class="btn btn-circle btn-ghost text-gray-500/80 icon icon-info" />
      <div class="max-w-96" Slot="popover">
        {hint}</div>
    </Popover>
  </Bar>
</Component>