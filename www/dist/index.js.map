<Component id="RadioGroup">
  <Signature purpose="Segmented button group for single selection"
    description="Horizontal joined button group for mutually exclusive options. Selected option is highlighted. Use for status toggles, view mode switches, or any single-choice from small option set (2-5 items)."
    group="Inputs">
    <Prop id="options" type="array" required="true"
      description="Array of {id, name, disabled?, isErroneous?} option objects" />
    <Prop id="value" type="any" description="Currently selected option ID" />
    <Prop id="change" type="action" required="true"
      description="Selection handler receiving data-value of clicked option" />
    <Prop id="name" type="string" description="Group name for form semantics" />
    <Prop id="size" type="enum" enum="xs,sm,md" description="Button size" />
    <Prop id="disabled" type="boolean" description="Disable all options" />
    <Prop id="itemClass" type="string" description="Additional CSS classes for each option button" />
    <Prop id="data" type="any" description="Data payload for change handler" />
  </Signature>
  <div class="join {class}" role="group">
    <div
      aria-label="{option.name}"
      aria-selected="{option.id == value}"
      class="join-item btn {arrayJoin(arrayPrefixAll('btn-', size),' ')} {option.isErroneous ? 'btn-error'} {option.id == value?'btn-active btn-accent':'btn-soft'} {itemClass}"
      name="{name}"
      data="{data}"
      data-value="{option.id}"
      click="{change}"
      disabled="{disabled || option.disabled}"
      Each="option of options">{ option.name ?? option.id }</div>
  </div>
</Component>