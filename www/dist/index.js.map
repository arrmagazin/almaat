<Component id="Alert">
  <Signature purpose="Notification banner for user feedback"
    description="Displays contextual messages (info, success, warning, error) with optional icon and action link. Use for system notifications, form validation feedback, or important announcements."
    group="Feedback">
    <Prop id="title" type="string" required="true" description="Main alert message text" />
    <Prop id="subtitle" type="string" description="Secondary descriptive text below title" />
    <Prop id="icon" type="string"
      description="Lucide icon name (e.g., 'info', 'check', 'alert-triangle')" />
    <Prop id="level" type="enum" enum="info,success,warning,error"
      description="Semantic alert level affecting color scheme" />
    <Prop id="mode" type="enum" enum="soft,outline,dash" description="Visual style variant" />
    <Prop id="link" type="string" description="URL for 'open' action link" />
    <Prop id="vertical" type="boolean"
      description="Stack icon and content vertically (default: horizontal)" />
    <Slot name="default" description="Additional content or action buttons" />
  </Signature>
  <div
    class="alert min-w-48
    {!vertical ? 'alert-horizontal' : 'alert-vertical'}
    {arrayJoin(arrayPrefixAll('alert-', mode, level),' ')} {class}"
  >
    <div class="icon icon-{icon}" If="icon" />
    <div>
      <h3 class="font-bold">{title}</h3>
      <div class="text-xs" If="subtitle">{subtitle}</div>
      <a class="font-bold text-xs" href="{link}" If="link">open</a>
    </div>
    <Slot />
  </div>
</Component>