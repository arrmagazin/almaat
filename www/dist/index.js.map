<Component id="TableRowGroup">
  <Signature purpose="Collapsible group of Table rows"
    description="Renders a sticky caption band with a chevron and, once expanded, one TableRow per child record. Table picks it automatically for items that carry an `items` array, so grouped data needs no extra wiring."
    group="Table">
    <Prop id="data" type="object" description="Group record: its name/id captions the band and its `items` are the child rows" />
    <Prop id="col1" type="object" description="Spec of the pinned first column, forwarded to every child row" />
    <Prop id="cols" type="array" description="Specs of the remaining columns, forwarded to every child row" />
    <Prop id="store" type="string" description="Data store name, forwarded to every child row" />
    <Prop id="noHeader" type="boolean" description="Set when the Table hides its header, so the caption sticks to the very top" />
    <Prop id="cellChange" type="action" description="Table `cellChange` handler, forwarded to every child row" />
    <Prop id="onItem" type="action" description="Table `onItem` handler, forwarded to every child row" />
  </Signature>
  <div
    class="grid grid-cols-subgrid gap-0 col-span-full sticky left-0 z-20
      {expander ? 'cursor-pointer'} bg-base-300"
    style="top:{noHeader ? '0' : '2.5rem;'}"
    data-id="{data.id}"
    click="-> expander = !expander">
    <div
      class="gap-1 sticky left-0 flex items-center"
      style="grid-column-start:1; grid-column-end: span 2;">
      <div
        class="btn btn-circle btn-ghost icon icon-chevron-right transition duration-300 {expander ? 'rotate-90':''}"
      />
      <TableRowGroupCaption
        value="{data.name ?? data.id}"
        data="{data}" />
    </div>
  </div>

  <Fragment If="expander">
    <TableRow Each="item of data.items"
      data="{item}"
      selected="{item.selected}"
      col1="{col1}"
      cols="{cols}"
      store="{store}"
      onItem="{onItem}"
      cellChange="{cellChange}" />
  </Fragment>
</Component>
