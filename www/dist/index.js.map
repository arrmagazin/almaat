<Component id="TagsView">
  <Signature purpose="Read-only list of tags rendered as badges"
    description="Renders a comma-separated tag list as sorted soft badges, collapsing to the first three with a more../less.. toggle beyond four tags. Use it in list rows and cards to show a record's tags without editing them."
    group="Data">
    <Prop id="data" type="string" description="Comma-separated tag ids; split, narrowed to items and sorted by id" />
  </Signature>
  <Subcomponent id="Content">
    <Badge mode="soft" type="info" text="{tag.name??tag.id}"
      Each="tag of slice(data, 0, data.length > 4 ? 3 : 4)"
    />
    <Fragment If="data.length > 4">
      <Fragment If="expanded">
        <Then>
          <Badge mode="soft" type="info" text="{tag.name??tag.id}" Each="tag of slice(data,3)" />
          <Btn size="sm" title="less.." mode="dash" action="-> expanded=false" />
        </Then>
        <Else>
          <Btn size="sm" title="more.." mode="dash" action="-> expanded=true" />
        </Else>
      </Fragment>
    </Fragment>
  </Subcomponent>

  <Bar class="break-words text-sm {class} flex-wrap">
    <TagsView-Content data="{arraySortBy(narrowItemList(stringSplit(data,',')),'id')}" />
  </Bar>
</Component>