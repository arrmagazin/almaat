<Component id="DocsTree">
  <Signature
    purpose="Docs file-tree navigator — renders nested dir/file structure and updates nav doc param on selection"
    description="Walks `data.nodes`, dispatching each entry to DocsTree.Dir or DocsTree.File by its `type`. Open state comes from `@docs.openPath` and the persisted `@treeState`, so the caller only supplies the tree."
    group="Books">
    <Prop id="data" type="object" required="true"
      description="Tree root; its `nodes` array holds the `{ id, type, name, nodes }` entries to render" />
  </Signature>

  <NavigationService Ref="nav" />

  <nav class="flex flex-col text-sm select-none">
    <Dynamic As="DocsTree.{capitalize(item.type)}" Props="{item}"
      open="{@docs.openPath[item.id] || @treeState.data[item.id]}"
      Each="item of data.nodes" />
  </nav>
</Component>
