<Component id="TableCell.Date">
  <Signature purpose="Date cell of a Table row"
    description="Renders a timestamp through the `date` formatter, read-only. A TableRow picks it for columns with type `date`."
    group="Table">
    <Prop id="value" type="string" description="Date value of this column for the row, passed through the `date` filter" />
  </Signature>
  <span class="px-2 py-1">{value | date}</span>
</Component>
