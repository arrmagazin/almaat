<Component id="Field.Radio">
  <Signature purpose="Segmented single-choice button group"
    description="Renders every enum option as a joined button so all choices stay visible, plus a removal button for a value that is no longer in the enum. Use for short closed sets where a dropdown would hide the options."
    group="Fields">
    <Prop id="value" type="string" description="Selected option id" />
    <Prop id="typeSpec" type="string" description="Key into R.enums naming the option list" />
    <Prop id="onChange" type="action" description="Called with the clicked option id, or an empty string from the removal button" />
    <Prop id="disabled" type="boolean" description="Greys the buttons and drops the click handlers" />
    <Prop id="class" type="string" description="Extra classes for the field frame" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" class="{class}" error="{error}" required="{required}" hint="{hint}">
    <div class="join border rounded-field w-full"
      role="group">
      <button If="value AND !find(R.enums[typeSpec],value)"
        class="btn join-item btn-error  flex-1 "
        title="remove '{value}'"
        data-value=""
        click="{!disabled ? onChange}">'{value}'✖
      </button>
      <button Each="option of R.enums[typeSpec]"
        class="btn join-item flex-1 
          {disabled ? 'disabled' : '' } 
          {option.id == value ? 'btn-accent' : '' } 
          {option.class}"
        title="{option.name}"
        data-value="{option.id}"
        click="{!disabled ? onChange}"
      >{option.name}
      </button>
    </div>
  </FieldItem>
</Component>