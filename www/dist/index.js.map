<Component id="Select">
  <Signature purpose="Native HTML select dropdown"
    description="Standard HTML select element for option selection. Shows error state (red) if value doesn't match any option. Use for form fields requiring native select behavior or accessibility compliance."
    group="Inputs">
    <Prop id="options" type="array" required="true"
      description="Array of {id, name, disabled?} option objects" />
    <Prop id="value" type="any" description="Currently selected option ID" />
    <Prop id="change" type="action" required="true"
      description="Selection handler called with event.target.value" />
    <Prop id="placeholder" type="string" default="..." description="Text for empty/default option" />
    <Prop id="required" type="boolean" description="Hide placeholder when value exists" />
    <Prop id="disabled" type="boolean" description="Disable selection" />
    <Prop id="multiple" type="boolean" description="Allow multiple selections (increases height)" />
    <Prop id="style" type="string" description="Additional inline CSS styles" />
    <Prop id="data" type="any" description="Data payload for change handler" />
  </Signature>
  <select
    class="select {class}"
    style="min-height:{!multiple?'2.5':'5'}rem;{style}"
    change="{change}"
    disabled="{disabled}"
    data="{data}">
    <option If="!required OR !value" selected="{!value}" value=""
      style="color: var(--color-base-content); opacity: 0.6;">
      {placeholder ?? '...'}
    </option>
    <option If="value AND !find(options, value)" selected="true" value="value"
      class="bg-error!" style="color: var(--color-error-content);">
      {value}
    </option>
    <option Each="option of options" selected="{str(option.id) == str(value)}" value="{option.id}"
      disabled="{option.disabled}">
      {option.name ?? capitalize(option.id)}
    </option>
  </select>
</Component>