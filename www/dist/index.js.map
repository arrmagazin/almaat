<Component id="Field.Textarea">
  <Signature purpose="Multi-line text field with voice dictation"
    description="A textarea plus a microphone button that records speech and offers the transcript for review before it replaces the text. Use for notes, comments and descriptions."
    group="Fields">
    <Prop id="value" type="string" description="Current text" />
    <Prop id="language" type="string" default="en-US" description="Speech recognition locale for the dictation button" />
    <Prop id="onChange" type="action" description="Called with the text on blur and with an applied voice transcript" />
    <Prop id="onKeypress" type="action" description="Called on every keystroke; also the voice fallback when onChange is absent" />
    <Prop id="onFocus" type="action" description="Called when the textarea gains focus" />
    <Prop id="onBlur" type="action" description="Called when the textarea loses focus" />
    <Prop id="disabled" type="boolean" description="Blocks typing and recording" />
    <Prop id="placeholder" type="string" description="Placeholder of the textarea" />
    <Prop id="class" type="string" description="Extra classes for the textarea" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
  </Signature>
  <TextareaVoiceController Ref="voiceCtrl"
    value="{value}"
    language="{language??'en-US'}"
    onChange="{onChange ?? onKeypress}" />

  <FieldItem caption="{caption}" error="{error}" required="{required}" disabled="{disabled}">
    <div class="w-full flex flex-col gap-2">
      <div class="relative">
        <Fragment If="@voiceCtrl.voiceText">
          <div class="p-3 bg-blue-50 rounded-md border border-blue-200">
            <div class="text-sm font-medium text-blue-900 mb-2">Voice Input:</div>
            <div class="text-sm text-blue-800 mb-3 italic">{@voiceCtrl.voiceText}</div>
            <Bar class="gap-2">
              <Btn
                size="sm"
                title="Apply"
                icon="check"
                mode="primary"
                class="bg-green-500 hover:bg-green-600"
                action="-> @voiceCtrl.applyVoiceInput()" />
              <Btn
                size="sm"
                title="Clear"
                icon="x"
                mode="ghost"
                action="-> @voiceCtrl.clearVoiceInput()" />
            </Bar>
          </div>
          <Else>
            <textarea class="textarea rounded-md w-full pr-24 {class}"
              placeholder="{placeholder}"
              disabled="{disabled}"
              change="{onChange}"
              keypress="{onKeypress}"
              focus="{onFocus}"
              blur="{onBlur}"
              value="{value}"
              style="white-space: pre-wrap; min-height: 2.5rem; white-space: pre-line">{value || ''}</textarea>
          </Else>
        </Fragment>
        <Bar class="absolute right-2 top-2 gap-1">
          <Fragment If="!@voiceCtrl.isRecording">
            <Then>
              <IBtn
                size="sm"
                icon="mic"
                mode="primary"
                click="-> @voiceCtrl.startRecording()"
                disabled="{disabled}"
                title="Start voice input" />
            </Then>
            <Else>
              <IBtn
                size="sm"
                icon="square"
                class="animate-pulse bg-red-500 hover:bg-red-600 text-white"
                click="-> @voiceCtrl.stopRecording()"
                title="Stop recording" />
            </Else>
          </Fragment>
        </Bar>
      </div>
    </div>
  </FieldItem>
</Component>