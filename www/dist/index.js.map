<Component id="Link">
  <Signature purpose="Generic Hyperlink"
    description="Anchor element withstyling for navigation. Use for links that should appear inline like text links . Ideal for 'Learn more', 'View details' type actions."
    group="Buttons">
    <Prop id="href" type="string" required="true" description="Navigation URL" />
    <Prop id="text" type="string" description="Link text label" />
    <Slot name="default" description="Custom link content (alternative to text prop)" />
  </Signature>

  <a class="{class}" href="{href}">
    <span If="text">{text}</span>
    <Slot />
  </a>
</Component>