<Components>
  <Component id="TableColHeader">
    <Signature purpose="Default column header of a Table"
      description="Renders a column caption in the Table's sticky header band. Table instantiates it per column spec, resolving a type-suffixed TableColHeader first, so add such a variant for a bespoke header instead of editing this one."
      group="Table">
      <Prop id="name" type="string" description="Column caption; falls back to the column id" />
      <Prop id="id" type="string" description="Column id, used as the caption when no name is given" />
    </Signature>
    <div class="p-2 font-bold text-sm truncate capitalize">{name ?? id}</div>
  </Component>

</Components>