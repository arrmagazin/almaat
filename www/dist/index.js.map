<Component id="MDTaskList">
  <Signature purpose="Bulleted GFM task list"
    description="Emitted by the markdown renderer for an unordered list whose first item carries a task marker (`- [ ]`). Each item pairs an MDCheckbox with its text."
    group="Markdown">
    <Prop id="depth" type="number" description="Nesting level; anything above 0 is indented" />
    <Prop id="class" type="string" description="Extra CSS classes for the list" />
    <Slot name="default" description="Task items" />
  </Signature>
  <ul class="list-disc px-4 list-inside my-2 space-y-1 text-sm {class} {depth==0?'':'ml-4'}">
    <Slot />
  </ul>
</Component>
