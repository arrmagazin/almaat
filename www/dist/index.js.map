<Component id="ItemsFilterSelectedFields">

  <Signature purpose="One dropdown per field the user chose to filter on"
    description="Renders a chip-and-dropdown for every entry in `@itemsFilter.selectedFields`, each listing that field's distinct values with occurrence counts and a text-search box. Place it beside ItemsFilter, which is what adds fields to that list. Takes no props — all state lives in the `@itemsFilter` service."
    group="Data" />

  <Subcomponent id="FieldOption">
    <li class="btn {isSelected?'btn-accent btn-soft':'btn-ghost'}">
      <input type="checkbox"
        checked="{isSelected}"
        class="checkbox"
        data-optionId="{id}"
        data-fieldId="{field.id}"
        change="-> @itemsFilter.toggleFieldOption()" />

      <div class="flex-1 capitalize text-start"
        data-optionId="{id}"
        data-fieldId="{field.id}"
        click="-> @itemsFilter.toggleFieldOption()"
        afterClick="{close}">{name}</div>

      <div class="badge badge-info badge-xs">{count}</div>
    </li>
  </Subcomponent>

  <Subcomponent id="Field">
    <FilterFieldHistogram Ref="histo" fieldId="{field.id}" ctrl="{@itemsFilter.This}" />
    <div class="{opened ? 'relative' : ''}">
      <div class="justify-start rounded-sm btn btn-soft flex-wrap! h-fit!">
        <div class="capitalize" click="-> opened=!opened">{field.name}</div>
        <div
          class="badge badge-primary badge-outline"
          If="field.pattern"
          data-fieldId="{field.id}"
          data-value="{''}"
          click="-> @itemsFilter.setFieldPattern()">
          <div class="px-1 rounded-l-lg flex-1 capitalize ">
            ~ {field.pattern}
          </div>
        </div>

        <div
          class="badge badge-primary badge-soft rounded-sm"
          Each="option of  @histo.data | filter : 'isSelected' : true"
          data-optionId="{option.id}"
          data-fieldId="{field.id}"
          click="-> @itemsFilter.toggleFieldOption()">
          <div class="flex-1 capitalize ">
            {option.name}
          </div>
          <div class="badge badge-info badge-xs">
            {option.count}
          </div>
        </div>
      </div>

      <div class="relative">
        <div dropdown="-> opened=false"
          class="bg-base-100 relative flex flex-col rounded-box shadow-lg z-50 p-1"
          style="min-width: 30rem; width: max-content;"
          If="opened">
          <div class="w-full flex items-center gap-1 pl-2 pr-1  py-1  border-b border-slate-900">
            <h3 class="capitalize divide-b flex-1 flex gap-1">
              <span>Filter by</span>
              <b>{field.name}</b>
            </h3>
            <Bar class="relative" If="@histo.data.length > 15">
              <input class="input bg-base-100 rounded-full w-36 flex-auto h-10 pr-10"
                type="text"
                autofocus="false"
                placeholder="Поиск"
                keypress="-> kliuq = event.value"
                change="-> kliuq = event.value"
                value="{kliuq}" />
              <button class="btn btn-circle btn-ghost absolute right-1">
                <Icon icon="search" class="h-6 w-6" />
              </button>
            </Bar>
            <IBtn icon="x" size="sm" click="-> opened=false" />
          </div>
          <div class="w-full flex items-center gap-1 pl-2 pr-1 py-1"
            If="field.typeSpec == 'pattern'">
            <input type="text"
              placeholder="Text search pattern"
              class="p-2 h-6 rounded-xs w-full input"
              data-fieldId="{field.id}"
              value="{field.pattern}"
              change="-> @itemsFilter.setFieldPattern()" />
          </div>
          <ul class="flex flex-col my-2 gap-0 w-full overflow-x-hidden"
            style="overflow-y: auto;max-height:30rem;min-width:10rem;list-style: none;">
            <This-FieldOption Each="option of @histo.data | filterByKeyword : kliuq : 'name'"
              Props="{option}"
              field="{field}"
              close="-> opened=false" />
          </ul>
        </div>
      </div>
    </div>
  </Subcomponent>

  <This-Field field="{field}" Each="field of @itemsFilter.selectedFields" />
</Component>