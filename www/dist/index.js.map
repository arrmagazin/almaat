<Component id="Btn">
  <Signature purpose="A clickable button"
    group="Buttons"
    description="Standard button component with various styles and sizes.">
    <Slot name="default" />
    <Prop id="class" type="class" description="Custom classes" />

    <Prop id="click" alias="action" type="action" description="action on click" />
    <Prop id="afterClick" alias="afterAction" type="action"
      description="secondary action after click" />

    <Prop id="type" type="enum"
      enum="neutral,ghost,primary,secondary,accent,error,warning,success"
      default="button" description="Visual type" />
    <Prop id="mode" type="enum" enum="dash,inverted,outline,soft" description="Visual mode" />

    <Prop id="busy" type="boolean" description="Show loading spinner" />
    <Prop id="disabled" type="boolean" default="false" description="Disables the button" />

    <Prop id="data" type="any" description="data to passed as parameter to the actions" />
    <Prop id="icon" type="string" description="Icon name" />

    <Prop id="size" type="enum" enum="lg,md,sm,xl,xs" description="Size of the button" />

    <Prop id="text" alias="title" type="string" description="label text" />
    <Prop id="alt" type="string" description="tooltip" />

    <Prop id="wrap" type="boolean" default="false"
      description="Let a multi-word label wrap onto several lines instead of ellipsing. Also releases the button's fixed height (h-auto + vertical padding) so the extra lines are visible." />
  </Signature>

  <button type="button" role="button"
    title="{alt || title || text}"
    disabled="{disabled ?? busy ?? false}"
    class="btn {arrayJoin(arrayPrefixAll('btn-', type, mode, size),' ')} {(disabled ?? busy) ? 'disabled' :''} {wrap ? 'h-auto py-2' : ''} {class}"
    data="{data}"
    click="{!disabled ? (action ?? click)}"
    afterClick="{!disabled ? (afterAction ?? afterClick)}">
    <span class="icon icon-{icon}" If="!busy AND icon"></span>
    <span class="loading loading-spinner loader-{size}" If="busy"></span>
    <span If="title ?? text"
      style="{wrap ? 'white-space: normal; overflow-wrap: anywhere;' : 'white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'}">
      {title || text}</span>
    <Slot />
  </button>
</Component>