<Component id="Field.Email">
  <Signature purpose="Email address input"
    description="Text field with the native email input type and an email-shaped placeholder. Use for contact and account addresses."
    group="Fields">
    <Prop id="id" type="string" description="Field id; becomes the input name" />
    <Prop id="value" type="string" description="Current address" />
    <Prop id="onChange" type="action" description="Called with the new address" />
    <Prop id="disabled" type="boolean" description="Blocks editing" />
    <Prop id="placeholder" type="string" default="e-mail address" description="Placeholder of the input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="helper" type="string" description="Prefix content of the field frame; the input drops its left rounding for it" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" helper="{helper}"
    disabled="{disabled}" hint="{hint}"
    value="{value}">
    <!-- The placeholder default carries no `@`: the expression compiler rewrites `@word.word`
         into a Ref lookup without respecting string quotes, so the previous 'example@gmail.com'
         resolved as `@gmail.com` and logged "No such ref: gmail" on every render. -->
    <input name="{id}"
      type="email"
      class="input {error ? 'border-red-600'} rounded-l-none"
      placeholder="{placeholder ?? 'e-mail address'}"
      required="{required}"
      value="{value}"
      change="{onChange}"
      disabled="{disabled}" />
  </FieldItem>
</Component>
