<Component id="TextView">
  <Signature purpose="Expandable view for long text"
    description="Shows the first words of a long string and hides the rest behind a more.../less toggle. Use it in table cells and cards where a full text would blow up the row height."
    group="Data">
    <Prop id="data" type="string" description="Text to display; split on spaces, truncated after six words until expanded" />
  </Signature>

  <Subcomponent id="Content">
    <span Each="tag of slice(data, 0, data.length > 6 ? 5 : 6)"
    >{tag.name}</span>
    <Fragment If="data.length > 6">
      <Fragment If="expanded">
        <Then>
          <span Each="tag of slice(data,5)">{tag.name}</span>
          <Btn size="sm" title="less" mode="ghost" action="-> expanded=false" />
        </Then>
        <Else>
          <Btn size="sm" title="more..." mode="ghost" action="-> expanded=true" />
        </Else>
      </Fragment>
    </Fragment>
  </Subcomponent>

  <Bar class="{class} flex-wrap" If="data">
    <This-Content data="{narrowItemList(stringSplit(data,' '),'id')}" />
  </Bar>
</Component>