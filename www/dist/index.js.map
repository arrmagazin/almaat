<Component id="Pivot">
  <Signature purpose="Two-dimensional summary grid with inline drill-down"
    description="Lays already pivoted rows and columns out as a scrollable grid of aggregated values with sticky headers and a totals row, and expands the records behind a cell as a list when it is clicked. Use it to summarize a flat collection across two fields."
    group="Data">
    <Prop id="rows" type="array"
      description="Pivot rows, each with a name, a total value, its own columns of cells and the records behind them" />
    <Prop id="columns" type="array"
      description="Column headers, each with an id, a name and a column total" />
    <Prop id="totalCount" type="number"
      description="Grand total shown in the footer corner; omit it to leave the corner empty" />
    <Prop id="itemComponent" type="string"
      description="Component id rendering one record in the drill-down list" default="Pivot-RowHeader" />
    <Prop id="filterProp" type="string"
      description="Record field the drill-down list searches on" />
    <Prop id="onItem" type="action"
      description="Fires with the record when a drill-down item is clicked" />
    <Prop id="onCell" type="action" description="Cell handler forwarded to every row" />
    <Slot name="default" description="Content of the top-left header corner" />
  </Signature>

  <Subcomponent id="RowHeader">
    <a href="#/items/{store}?itemId={encodus(id)}"
      class="font-medium truncate bg-base-200 flex">
      <span class="truncate break-words">{data[params.id] || name || ' Ø '}</span>
    </a>
  </Subcomponent>

  <Subcomponent id="Row">
    <div
      class="sticky top-0 left-0 right-0 z-10
          grid grid-cols-subgrid gap-0 col-span-full"
      style="order:2; box-sizing: border-box;"
    >
      <div
        class="p-2 snap-start sticky z-50 left-0 top-0 bg-base-200 flex items-center">
        <span>{row.name || ' Ø '}</span>
      </div>
      <div title="{cell.value}"
        Each="cell of row.columns"
        class="text-sm snap-start top-0 z-20 bg-base-100
        justify-end btn btn-block rounded-none {cellDetails.id == cell.id ? 'btn-primary': 'btn-ghost'}"
        data="{cellDetails.items.length ? false : cell}"
        disabled="{!cell.items.length}"
        click="-> cellDetails">{cell.value || '_'}
      </div>
      <div
        class="justify-end btn btn-block rounded-none {cellDetails.id == row.id ? 'btn-primary': 'btn-ghost'}"
        data="{cellDetails.items.length ? false : row}"
        disabled="{!row.items.length}"
        click="-> cellDetails">{row.value}
      </div>
      <div class="px-2 py-1 bg-base-100" title="{cellDetails.name}"
        style="grid-column-start:1; grid-column-end: span {row.columns.length + 2};"
        If="cellDetails.items.length">
        <ListView
          listClass="flex flex-col gap-2 w-full divide-y max-h-48 overflow-y-auto"
          itemClass=""
          filterProp="{filterProp}"
          itemAs="{itemComponent}"
          data="{cellDetails.items}" params="{col1}" onItem="{onItem}" />
      </div>

    </div>
  </Subcomponent>

  <div
    class="flex-auto grow-0 min-h-0 grid overflow-auto {class}"
    style="display: grid; box-sizing: border-box;
        grid-template-rows: auto auto 1fr;
        grid-template-columns: minmax(12rem, 1fr) {columns.length ? 'repeat('+columns.length+', minmax(4rem, 16rem))':''} minmax(4rem, 8rem);
        ">

    <div class="grid grid-cols-subgrid gap-0 col-span-full"
      style="order: 1;">
      <This-Row row="{row}"
        onItem="{onItem}"
        onCell="{onCell}"
        filterProp="{filterProp}"
        itemComponent="{itemComponent ?? 'Pivot-RowHeader'}"
        Each="row of rows" />
    </div>

    <!-- Footer -->
    <div
      class="sticky top-0 left-0 right-0 z-10
          bg-base-300 border border-base-content/10
          grid grid-cols-subgrid gap-0 col-span-full"
      style="order:2; box-sizing: border-box;"
    >
      <div
        class="p-2 snap-start sticky bg-base-300 z-50 left-0 top-0 bg-base-300 flex items-center">
        <div class="truncate">Σ</div>
      </div>
      <div title="{col.value}"
        class="pr-4 text-sm snap-start top-0 z-20 bg-base-300 flex justify-end items-center"
        Each="col of columns">
        <div class="truncate">{col.value}</div>
      </div>
      <div class="pr-4 flex justify-end items-center">
        <div If="totalCount" class="">{totalCount}</div>
      </div>
    </div>

    <div class="col-span-full order-3" style="order: 3;">
      <div style="height:5rem;"></div>
    </div>

    <!-- Header -->
    <div
      class="sticky top-0 left-0 right-0 z-10 
      bg-base-300 border border-base-content/10
      font-bold text-sm
      grid grid-cols-subgrid gap-0 col-span-full"
      style="order:0; box-sizing: border-box;"
    >
      <div
        class="p-2 snap-start sticky bg-base-300 z-50 left-0 top-0 flex items-center">
        <Slot />
      </div>
      <div title="{col.name}" class="pr-4 snap-start top-0 z-20 flex justify-end items-center"
        Each="col of columns">
        <div class="truncate">{col.name || ' Ø '}</div>
      </div>
      <div title="{col.name}" class="pr-4 snap-start top-0 z-20 flex justify-end items-center">
        <div If="totalCount" class="truncate">Σ</div>
      </div>
    </div>
  </div>

</Component>