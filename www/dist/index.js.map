<Component id="FAB">
  <Signature purpose="Floating action button fixed to bottom-right"
    description="Large circular button fixed at bottom-right corner for primary page action. Shows loading spinner when busy. Use for main create/add actions like 'New Item', 'Compose', or 'Add Record'."
    group="Buttons">
    <Prop id="action" type="action" required="true"
      description="Click handler for the primary action" />
    <Prop id="icon" type="string" default="plus" description="Lucide icon name (default: 'plus')" />
    <Prop id="title" type="string" description="Tooltip text on hover" />
    <Prop id="busy" type="boolean" description="Show loading spinner instead of icon" />
    <Prop id="disabled" type="boolean" description="Disable button interaction" />
    <Prop id="data" type="any" description="Data payload for action handler" />
  </Signature>
  <button
    type="button"
    role="button"
    disabled="{disabled ?? busy ?? false}"
    class="btn btn-circle bt-lg
        fixed mx-5 mb-5 bottom-2 right-2
        shadow-md hover:shadow-lg active:shadow-lg 
        transition duration-150 ease-in-out 
        {class}"
    data="{data}"
    title="{title}"
    click="{!disabled ? action}"
    afterClick="{!disabled ? afterAction}">
    <span class="loading loading-spinner" If="busy"></span>
    <div class="icon icon-{icon ?? 'plus'}" If="!busy" />
  </button>
</Component>