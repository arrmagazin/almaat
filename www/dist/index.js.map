<Component id="XmlNodeView">
  <Signature purpose="Dispatcher that picks the renderer for one XML node" group="XmlView"
    description="Sends an object node to XmlElement and a string node to XmlTextNode, and shows an invalid-node marker for anything else. Internal to XmlView; it also decides that nodes deeper than level 3 start folded.">
    <Prop id="node" type="any"
      description="XML node: an object for an element, a string for text" />
    <Prop id="level" type="number" description="Nesting depth of this node" />
  </Signature>
  <Selector On="{node|typeOf}">
    <Case When="object">
      <XmlElement node="{node}" level="{level}" collapse="{level > 3}" />
    </Case>
    <Case When="string">
      <XmlTextNode text="{node}" />
    </Case>
    <Case When="default">
      <span class="text-red-300">[Invalid node]</span>
    </Case>
  </Selector>
</Component>
