<Component id="Forma">
  <Signature purpose="Renders a whole data form from a field-metadata list"
    description="The form engine: hands `meta` to FormController, which groups the fields into tabs and dispatches each one to `Field.{type}`. Reach for it whenever a form's shape is data rather than markup — a record editor, a settings panel, a sign-in card. Set `metaId` when two forms share a route, since it keys the rendering cache."
    group="Fields">
    <Prop id="meta" type="array" required="true" description="Field definitions: `{ id, name, type, typeSpec, group, tab, cols, required, hidden }` records" />
    <Prop id="data" type="object" description="The record being edited; each field reads and writes `data[field.id]`" />
    <Prop id="change" type="action" description="Fires with the updated record whenever any field changes" />
    <Prop id="metaId" type="string" description="Form identity; part of the cache key, so distinct forms on one page need distinct values" />
    <Prop id="tabs" type="object" description="Tab id to label map; fields land on the tab named by their `tab` key" />
    <Prop id="errors" type="array" description="Validation errors as `{ field, message }`, shown against the matching field" />
    <Prop id="context" type="object" description="Extra values used when evaluating a group's conditional predicate" />
    <Prop id="disabled" type="boolean" description="Makes every field read-only and greys the form" />
    <Prop id="class" type="string" description="Extra classes on the form wrapper" />
    <Slot name="default" description="Content pinned into the tab strip, e.g. a save button" />
  </Signature>

  <div class="flex flex-col-reverse {class}">

    <FormController Ref="formController"
      data="{data}"
      meta="{meta}"
      metaId="{metaId}"
      change="{change}"
      tabs="{tabs}"
      errors="{errors}"
      context="{context}"
      disabled="{disabled}" />

    <Dynamic As="Forma-Content.{metaId + data.id}"
      Props="{@formController.tabsInfo}"
      tabId="@formController.tabId">
      <Slot />
    </Dynamic>
  </div>

  <Subcomponent id="Content">

    <div
      class="flex-initial gap-2 {tabId != tab.id ? 'hidden'} {@formController.disabled? 'bg-base-200'}"
      Each="tab of tabs">
      <Forma-Group
        Props="{group}"
        Each="group of tab.items" />
    </div>

    <div class="" If="fixedTab">
      <Forma-Group Props="{group}" Each="group of fixedTab.items" />
    </div>


    <Tabs items="{tabs}"
      class="sticky px-2 top-0 bg-base-200"
      change="-> @formController.tabId = event.value"
      value="{tabId}"
      If="tabs.length | greater : 1">
      <Slot />
    </Tabs>
  </Subcomponent>

  <Subcomponent id="GroupContent">
    <div class="mt-2 mb-2 grid gap-2"
      style="grid-template-columns: repeat({cols??1}, minmax(0, 1fr));">
      <Dynamic As="Field.{field.type | capitalize}"
        Props="{field}"
        Each="field of fields|filterNot:'hidden'" />
    </div>
  </Subcomponent>
  <Subcomponent id="Group">
    <div If="!hidden" class="mt-2 px-2">
      <Fragment If="isConditional">
        <Then>
          <Checkbox id="{id}" value="{@formController.data[id]}" title="{name??id}"
            change="{onChange}" class="text-sm font-semibold" />
          <div class="ml-6 mt-2 mb-2 p-2 pr-0 border border-base-300 border-dotted rounded-md"
            If="@formController.data[id]">
            <This-GroupContent fields="{items}" cols="{cols}" />
          </div>
        </Then>
        <Else>
          <h6 class="mt-4 text-sm font-semibold" If="name">{name}</h6>
          <This-GroupContent fields="{items}" cols="{cols}" />
        </Else>
      </Fragment>
    </div>
  </Subcomponent>
</Component>