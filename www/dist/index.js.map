<Component id="MDCodeElt">
  <Signature purpose="One syntax-highlighted token inside a code block"
    description="Emitted by the highlighter for every scoped highlight.js node, as `MDCodeElt.&lt;Scope&gt;` (Keyword, String, Comment, …) so a scope may be styled on its own. Not used outside MDCode."
    group="Markdown">
    <Prop id="class" type="string" description="Colour classes chosen for the token's highlight scope" />
    <Slot name="default" description="Token text, or nested highlighted tokens" />
  </Signature>
  <span class="{class}">
    <Slot />
  </span>
</Component>
