<Component id="JsonAttrAndValue">
  <Signature purpose="One key and value line of a JSON object" group="JsonView"
    description="Renders a single object entry as a clickable key followed by its recursively rendered value. Used by JsonAnyView for every property of an object.">
    <Prop id="item" type="object"
      description="Map entry to render: id is the key, value is the payload" />
    <Prop id="collapse" type="boolean"
      description="Initial folded state of the value; clicking the key toggles it" />
    <Prop id="level" type="number" description="Nesting depth, passed on to the value" />
  </Signature>
  <span>
    <span class="inline-block text-green-400 cursor-pointer" click="-> collapse=!collapse">
      {item.id}</span>
    <span class="text-orange-200 inline-block mr-2">: </span>
    <JsonAnyView data="{item.value}" collapsed="{collapse}" collapse="-> collapse=!collapse"
      level="{level|increment}" />
    <div class="text-orange-100"></div>
  </span>
</Component>
