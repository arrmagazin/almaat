<Component id="Field.Time">
  <Signature purpose="Time-of-day text field"
    description="A text input showing the value formatted as hh:mm. Use when only a clock time is stored."
    group="Fields">
    <Prop id="value" type="string" description="Time value; reformatted to hh:mm for display" />
    <Prop id="onChange" type="action" description="Called with the typed time" />
    <Prop id="disabled" type="boolean" description="Blocks editing" />
    <Prop id="placeholder" type="string" description="Placeholder of the input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}">
    <input type="text" class="input" disabled="{disabled}"
      placeholder="{placeholder}"
      value="{ value | dateFormat : 'hh:mm' }" change="{onChange}" />
  </FieldItem>
</Component>
