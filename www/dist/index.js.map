<Component id="MarkdownView">
  <Signature purpose="Renders a Markdown string as a component tree"
    description="Parses Markdown — frontmatter, tables, task lists, code blocks and mermaid included — into real components rather than injected HTML, so an app can restyle or override any element. Use it for docs pages, help panels and any user-authored text."
    group="Markdown">
    <Prop id="text" type="string" description="Markdown source to render" />
    <Prop id="key" type="string"
      description="Stable id for the document; when omitted a hash of the text is used" />
    <Prop id="prefix" type="string"
      description="Tag prefix of the generated nodes, so an app can register its own renderers"
      default="MD" />
  </Signature>
  <MarkdownViewService Ref="mdService" key="{key}" prefix="{capitalize(prefix)}" text="{text}" />
  <View class="relative {class}" If="@mdService.mdKey">
    <Block Nodes="{@mdService.nodes}" />
  </View>
</Component>
