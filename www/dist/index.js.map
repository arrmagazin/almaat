<Component id="Text">
  <Signature purpose="Styled text span with size variants"
    description="Inline text element with configurable size. Use for labels, captions, or any text that needs size variation. Prefer native HTML for headings (h1-h6) and paragraphs."
    group="Typography">
    <Prop id="text" type="string" description="Text content to display" />
    <Prop id="size" type="enum" enum="xs,sm,md,lg,xl,2xl" description="Tailwind text size class" />
  </Signature>
  <span class="{arrayJoin(arrayPrefixAll('text-', size),' ')} {class}">{text}</span>
</Component>
