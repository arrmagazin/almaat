<Component id="Field.StartDateAndLength">
  <Signature purpose="Start date paired with a duration select"
    description="A native date picker plus a dropdown of period lengths kept in a sibling field. Use when a span is recorded as a start plus a duration rather than as two dates."
    group="Fields">
    <Prop id="value" type="string" description="Start date, bound to the native date input" />
    <Prop id="typeSpec" type="string" description="Key of the sibling length field inside data" />
    <Prop id="data" type="object" description="Whole form record; the chosen length is read from it by the typeSpec key" />
    <Prop id="onChange" type="action" description="Called with the new start date" />
    <Prop id="disabled" type="boolean" description="Blocks the date input" />
    <Prop id="placeholder" type="string" description="Placeholder of the date input" />
    <Prop id="caption" type="string" description="Field label shown above the control" />
    <Prop id="error" type="string" description="Validation message; rendered under the control when set" />
    <Prop id="required" type="boolean" description="Marks the field as required (asterisk next to the caption)" />
    <Prop id="hint" type="string" description="Help text shown in an info popover beside the control" />
  </Signature>
  <FieldItem caption="{caption}" error="{error}" required="{required}" hint="{hint}"
    disabled="{disabled}">
    <div class="w-full flex">
      <input class="input w-32 rounded-r-none" type="date" disabled="{disabled}"
        placeholder="{placeholder}" value="{value}"
        change="{onChange}" />
      <Select class="w-16 rounded-r-lg" disabled="{!value ?? disabled}" required="true"
        change="{onChangeFor[typeSpec]}" placeholder="-"
        value="{data | dot:typeSpec}"
        options="{R.enums.daysPeriod}" />
    </div>
  </FieldItem>
</Component>
