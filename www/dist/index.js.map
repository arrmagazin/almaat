<Component id="Table">
  <Signature purpose="Editable data grid with a sticky header"
    description="Renders a record collection as a subgrid table: a pinned first column, one typed cell per remaining column, and an optional checkbox column and drag handle. Reach for it whenever a list needs columns, inline editing, multi-select or reordering; each handler you pass turns the matching feature on."
    group="Table">
    <Prop id="data" type="array"
      description="Records to render; an item that carries an items array is rendered as a TableRowGroup" />
    <Prop id="columns" type="array"
      description="Column specs, each with an id, a type and optional width and class. The first one is pinned, the rest scroll" />
    <Prop id="store" type="string"
      description="Name of the store the records come from, forwarded to every row" />
    <Prop id="value" type="string"
      description="Initially selected ids, as a comma-separated string or an array" />
    <Prop id="noHeader" type="boolean" description="Hides the sticky header row" />
    <Prop id="rowComponent" type="string"
      description="Component id rendering one row; defaults to TableRow, or TableRowGroup for a grouped item" />
    <Prop id="headerComponent" type="string"
      description="Column header type used for columns that declare none of their own" />
    <Prop id="onItem" type="action"
      description="Fires with the record when its first-column cell is clicked" />
    <Prop id="cellChange" type="action"
      description="Fires when an editable cell commits a value; passing it turns inline editing on" />
    <Prop id="onListReorder" type="action"
      description="Fires with the dragged and the target id; passing it turns drag reordering on" />
    <Prop id="onMultiSelectItem" type="action"
      description="Fires with the whole selection; passing it turns the checkbox column on" />
    <Prop id="onToggleItem" type="action"
      description="Fires per checkbox toggle with the item id and its new selected state" />
    <Prop id="scrolledDown" type="action"
      description="Fires when the grid is scrolled to the bottom, for paging in more records" />
    <Slot name="default" description="Header cell above the pinned first column" />
  </Signature>

  <MultiSelectController Ref="tableMultiSelect"
    value="{value}"
    data="{data}"
    disabled="{!onMultiSelectItem AND !onToggleItem}"
    onToggleItem="{onToggleItem}"
    change="{onMultiSelectItem}" />

  <OrderedListController Ref="tableOrdering"
    data="{data}"
    disabled="{!onListReorder}"
    change="{onListReorder}" />

  <Connector Ref="table columns" data="{columns|slice:1}" change="-> cols" />

  <Connector Ref="table widths" If="cols"
    data="{arrayJoin(map(cols, R.functions.dot, 'width', null, 'minmax(8rem, 1fr)'),' ')}"
    change="-> colsWidths" />

  <div If="colsWidths"
    class="flex-auto grow-0 min-h-0 grid overflow-auto {class}"
    style="display: grid; box-sizing: border-box;
        grid-template-rows: auto auto 1fr;
        grid-template-columns: {2 +(@tableOrdering.disabled?0:3)}rem {columns.0.width || 'minmax(12rem, 1fr)'} {colsWidths};
        "
    scrolledDown="{scrolledDown}">

    <div class="grid grid-cols-subgrid gap-0 col-span-full"
      style="order: 1;">
      <Dynamic As="{rowComponent ?? (item.items ? 'TableRowGroup' : 'TableRow')}"
        Each="item of data"
        data="{item}"
        selected="{item.selected}"
        noHeader="{noHeader}"
        col1="{columns.0}"
        cols="{cols}"
        store="{store}" cellChange="{cellChange}" onItem="{onItem}" />
    </div>

    <div class="col-span-full order-3" style="order: 3;">
      <div style="height:5rem;"></div>
    </div>

    <div
      class="sticky top-0 left-0 right-0 z-10
          grid grid-cols-subgrid gap-0 col-span-full"
      style="order:0; box-sizing: border-box;"
      If="!noHeader">
      <div
        class="snap-start sticky left-0 z-50 top-0
        bg-base-300
        border border-base-content/10
        flex items-center p-2 justify-center">
        <input
          class="checkbox checkbox-sm"
          type="checkbox"
          checked="@tableMultiSelect.isAllSelected"
          If="@tableMultiSelect.enabled AND @tableMultiSelect.canSelectAll"
          change="-> @tableMultiSelect.toggleAll()" />
      </div>
      <div
        class="border border-base-content/10 p-2 snap-start sticky z-50
            left-8 top-0 bg-base-300 flex items-center">
        <Slot />
      </div>
      <div title="{item.name ?? item.id}"
        class="flex items-center border border-base-content/10 snap-start top-0 z-20 bg-base-300"
        Each="item of cols">
        <Dynamic
          As="TableColHeader.{capitalize(item.headerType ?? headerComponent ?? item.type)}"
          Props="{item}" />
      </div>
    </div>
  </div>
</Component>