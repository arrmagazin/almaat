<Component id="Modal">
  <Signature purpose="Full-screen dialog overlay with header/body/footer"
    description="Centered modal dialog with backdrop, header bar, scrollable body, and footer for actions. Use for forms, confirmations, detail views, or any focused interaction requiring user attention."
    group="Layout">
    <Prop id="hidden" type="boolean" description="Hide the modal (use for conditional rendering)" />
    <Prop id="close" type="action" required="true"
      description="Handler to close the modal (called by X button and backdrop click)" />
    <Prop id="title" type="string" description="Header title text" />
    <Prop id="closeTitle" type="string" default="Close"
      description="Tooltip and accessible name of the X button — an icon-only button has no label without it" />
    <Slot name="header" description="Custom header content (replaces title)" />
    <Slot name="default" description="Modal body content (scrollable)" />
    <Slot name="footer" description="Footer content for action buttons" />
  </Signature>
  <div
    class="fixed top-0 left-0 right-0 bottom-0 inset-0 z-50 {hidden ? 'hidden':''} m-2 w-full px-4 py-4"
    portal2="modal">
    <This-Backdrop click="{close}" opened="{!hidden}" />
    <div
      class="relative bg-base-100 rounded-lg shadow-xl/80
       w-full m-auto max-w-2xl h-full 
       flex flex-col {class}">

      <!-- Modal header -->
      <Bar class="relative p-2 bg-base-200 flex gap-2">
        <div class="flex-1 mr-2 flex items-center"
          If="title">
          <h2 class="text-lg font-bold">{title}</h2>
        </div>
        <div class="flex-1 flex items-center overflow-hidden"
          If="Slot(header)">
          <Slot Key="header" />
        </div>
        <IBtn icon="x" size="sm" title="{closeTitle ?? 'Close'}" click="{close}" />
      </Bar>

      <!-- Modal body -->
      <div class="flex-1 min-h-0 flex flex-col overflow-auto">
        <Slot />
      </div>

      <!-- Modal footer -->
      <div If="Slot(footer)"
        class="p-2 flex items-center justify-end space-x-2 rounded-b">
        <Slot Key="footer" />
      </div>
    </div>
  </div>

  <Subcomponent id="Backdrop">
    <div
      class="{!opened ? 'hidden'} 
    fixed right-0 left-0 top-0 bottom-0 
    overflow-scroll
    max-sm:bg-neutral max-sm:opacity-50 max-sm:blur-xs {class}"
      click="{click}">
      <Slot />
      <div style="height:1000000px"></div>
    </div>
  </Subcomponent>
</Component>