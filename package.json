{
  "name": "almaat",
  "description": "Almaat book",
  "version": "1.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "PORT=8091 npm run start",
    "prestart": "npm run gen:docs-index",
    "start": "npm run stop && npx --yes npm-run-all --parallel start:*",
    "start:serve": "bun ./scripts/serve.ts",
    "start:css": "npm run build:css -- --watch",
    "start:open": "npx --yes wait-on http://localhost:${PORT:?no port} && open http://localhost:${PORT:?no port}/",
    "stop": "lsof -t -sTCP:LISTEN -i tcp:${PORT:-8091} | xargs -r kill -9",
    "prebuild": "npm run gen:docs-index",
    "build": "npx --yes npm-run-all --parallel build:*",
    "build:ts": "bun ./scripts/build.ts",
    "build:css": "npx --yes @tailwindcss/cli -i index.css -o \"www/dist/index.css\"",
    "book": "bun ./book/build.ts",
    "deploy": "firebase deploy --only hosting --config ./firebase.json -P parlang",
    "gen:docs-index": "DOCS_ROOT=docs bun ./scripts/gen-docs-index.ts",
    "absorb-watch-later": "node scripts/wl-absorb.mjs --browser \"chrome:Profile 1\"",
    "absorb-youtube": "node scripts/yt-fetch.mjs --count 10 && claude -p /yt-absorb --permission-mode acceptEdits",
    "check-docs": "node scripts/check-docs.mjs",
    "version:patch": "npm version patch",
    "postinstall": "npm run link:www",
    "link:modules": "./scripts/link-modules.sh arrmatura-web arrmatura-books ultimus",
    "link:www": "ln -sfn ../docs www/docs && ln -sfn ../index.json www/index.json",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "daisyui": "^5.7.37",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "arrmatura-web": "^9.1.1"
  }
}
