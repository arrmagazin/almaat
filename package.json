{
  "name": "almaat",
  "type": "module",
  "displayName": "Almaat",
  "description": "A layered knowledge base of foundational terms",
  "version": "1.0.8",
  "author": "Company, Inc",
  "keywords": [
    "knowledge",
    "almaat"
  ],
  "logo": "/favicon.svg",
  "email": "contact@company.com",
  "copyright": "© 2025. All rights reserved.",
  "book": {
    "title": "ALMAAT",
    "subtitle": "A general-purpose framework for cognitive modeling",
    "author": "Almaat",
    "language": "en-GB",
    "rights": "© 2025 Almaat. All rights reserved.",
    "description": "One ontology built from a single primitive, then applied to the human, the collective, and daily practice.",
    "subject": [
      "Cognitive modeling",
      "Ontology",
      "Philosophy of mind"
    ],
    "coverPhoto": "cover.png"
  },
  "hotPort": 8191,
  "scripts": {
    "link": "proton link-modules",
    "postinstall": "npm run link",
    "start": "export PORT=${PORT:-8091} && npm run stop && npx --yes npm-run-all --parallel start:*",
    "start:serve": "proton serve",
    "start:css": "npm run build:css -- --watch",
    "start:index": "npm run build:index -- --watch",
    "start:hot": "proton hot www/dist $(jq .hotPort package.json)",
    "start:open": "npx --yes wait-on http://localhost:${PORT:-8091} && open http://localhost:${PORT:-8091}/",
    "stop": "lsof -t -sTCP:LISTEN -i tcp:${PORT:-8091},$(jq .hotPort package.json) | xargs -r kill -9",
    "build": "npx --yes npm-run-all --parallel build:*",
    "build:ts": "proton build",
    "build:index": "proton index-docs docs",
    "build:sitemap": "proton sitemap https://almaat.web.app docs",
    "build:css": "proton build-css",
    "book": "bun ../../libs/arrmatura-books/book/build.ts",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only hosting -P parlang",
    "gates": "npm run check:diagrams",
    "check:diagrams": "git ls-files -z 'docs/*.md' | xargs -0 bun ../../libs/arrmatura-markdown/scripts/check-diagrams.ts"
  },
  "esbuild": {
    "entryPoints": [
      "index.ts"
    ]
  },
  "devDependencies": {
    "daisyui": "^5.7.50",
    "proton": "file://../../libs/proton",
    "tailwindcss": "^4.3.3"
  }
}
