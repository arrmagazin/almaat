{
  "name": "almaat",
  "type": "module",
  "displayName": "Almaat",
  "description": "A layered knowledge base of foundational terms",
  "version": "1.0.8",
  "author": "Company, Inc",
  "keywords": [
    "knowledge",
    "almaat"
  ],
  "logo": "/favicon.svg",
  "email": "contact@company.com",
  "copyright": "© 2025. All rights reserved.",
  "book": {
    "title": "ALMAAT",
    "subtitle": "A general-purpose framework for cognitive modeling",
    "author": "Almaat",
    "language": "en-GB",
    "rights": "© 2025 Almaat. All rights reserved.",
    "description": "One ontology built from a single primitive, then applied to the human, the collective, and daily practice.",
    "subject": [
      "Cognitive modeling",
      "Ontology",
      "Philosophy of mind"
    ],
    "coverPhoto": "cover.png"
  },
  "scripts": {
    "link": "arrmatura-support link-modules",
    "postinstall": "npm run link",
    "start": "export PORT=${PORT:-8091} && npm run stop && npx --yes npm-run-all --parallel start:*",
    "start:serve": "arrmatura-web serve --hot",
    "start:css": "npm run build:css -- --watch",
    "start:index": "npm run build:index -- --watch",
    "start:open": "npx --yes wait-on http://localhost:${PORT:-8091} && open http://localhost:${PORT:-8091}/",
    "stop": "lsof -t -sTCP:LISTEN -i tcp:${PORT:-8091} | xargs -r kill -9",
    "build": "npx --yes npm-run-all --parallel build:*",
    "build:ts": "arrmatura-web build",
    "build:index": "arrmatura-support index-docs docs",
    "build:sitemap": "arrmatura-support sitemap https://almaat.web.app docs",
    "build:css": "tailwindcss -i index.css -o www/dist/index.css",
    "book": "bun ../../libs/arrmatura-books/book/build.ts",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only hosting -P parlang",
    "check:deps": "arrmatura-support check-deps",
    "gates": "npm run check:deps && npm run check:diagrams",
    "check:diagrams": "git ls-files -z 'docs/*.md' | xargs -0 bun ../../libs/arrmatura-markdown/scripts/check-diagrams.ts"
  },
  "esbuild": {
    "entryPoints": [
      "index.ts"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "arrmatura": "file://../../libs/arrmatura",
    "arrmatura-books": "file://../../libs/arrmatura-books",
    "arrmatura-markdown": "file://../../libs/arrmatura-markdown",
    "arrmatura-web": "file://../../libs/arrmatura-web",
    "daisyui": "^5.7.50",
    "arrmatura-support": "file://../../libs/arrmatura-support",
    "tailwindcss": "^4.3.3",
    "ultimus": "file://../../libs/ultimus"
  }
}
